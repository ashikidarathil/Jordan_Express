<%- include('../partials/user/header') %>

<style>
    :root {
        --primary-color: #895D39;
        --secondary-color: #fcfcfc;
        --accent-color: #ffffff;
        --text-dark: #2d2d2d;
        --text-muted: #6c757d;
        --border-color: rgba(0,0,0,0.08);
    }

    body {
        background-color: #f8f9fa;
    }

    .checkout-wrapper {
        padding: 20px 0 80px;
    }

    .checkout-premium-container {
        background-color: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        padding: 30px;
        border: 1px solid var(--border-color);
        margin-top: 5px;
    }

    .section-card {
        background: #fff;
        border-radius: 15px;
        border: 1px solid #f1f1f1;
        padding: 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

    .checkout-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text-dark);
        margin-bottom: 1rem;
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
    }

    .section-title::after {
        content: '';
        position: absolute;
        bottom: -8px;
        left: 0;
        transform: none;
        width: 40px;
        height: 2.5px;
        background-color: var(--primary-color);
        border-radius: 2px;
    }

    /* Address Cards */
    .address-card-custom {
        border: 2px solid #f0f0f0;
        border-radius: 16px;
        padding: 20px;
        cursor: pointer;
        transition: all 0.25s ease;
        position: relative;
        background: #fff;
        height: 100%;
    }

    .address-card-custom:hover {
        border-color: var(--primary-color);
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(137, 93, 57, 0.08);
    }

    .address-card-custom.selected {
        border-color: var(--primary-color);
        background-color: #fdfaf8;
    }

    .address-card-custom.selected::after {
        content: '\f058';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        position: absolute;
        top: 15px;
        right: 15px;
        color: var(--primary-color);
        font-size: 1.2rem;
    }

    .address-label {
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 8px;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
    }

    /* Order Items */
    .checkout-item {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 15px 0;
        border-bottom: 1px solid #f8f8f8;
    }

    .checkout-item:last-child {
        border-bottom: none;
    }

    .product-img-checkout {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #f1f1f1;
    }

    /* Order Summary Sidebar */
    .summary-sidebar {
        position: sticky;
        top: 100px;
    }

    .summary-card {
        background: #fff;
        border-radius: 15px;
        padding: 20px;
        border: 1px solid #f1f1f1;
        box-shadow: 0 10px 30px rgba(0,0,0,0.02);
    }

    .summary-line {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    .summary-total {
        border-top: 2px dashed #f1f1f1;
        padding-top: 15px;
        margin-top: 15px;
        font-weight: 800;
        font-size: 1.15rem;
        color: var(--text-dark);
    }

    /* Coupon Section */
    .coupon-box {
        background: #fdfaf8;
        border-radius: 15px;
        padding: 15px;
        border: 1px solid rgba(137, 93, 57, 0.1);
        margin-top: 15px;
    }

    .coupon-item-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 12px;
        background: #fff;
        border-radius: 10px;
        margin-bottom: 8px;
        border: 1px solid #eee;
    }

    /* Payment Methods */
    .payment-option-custom {
        display: block;
        position: relative;
        padding: 12px 12px 12px 45px;
        margin-bottom: 10px;
        cursor: pointer;
        border: 1.5px solid #f0f0f0;
        border-radius: 10px;
        transition: all 0.2s;
        font-weight: 600;
        color: var(--text-dark);
        font-size: 0.9rem;
    }

    .payment-option-custom:hover {
        background: #fcfcfc;
        border-color: #ddd;
    }

    .payment-option-custom input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
    }

    .payment-checkmark {
        position: absolute;
        top: 50%;
        left: 15px;
        transform: translateY(-50%);
        height: 20px;
        width: 20px;
        background-color: #fff;
        border: 2px solid #ddd;
        border-radius: 50%;
    }

    .payment-option-custom input:checked ~ .payment-checkmark {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

    .payment-checkmark:after {
        content: "";
        position: absolute;
        display: none;
        left: 6px;
        top: 2px;
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .payment-option-custom input:checked ~ .payment-checkmark:after {
        display: block;
    }

    .payment-option-custom.disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Modals */
    .checkout-modal {
        display: none;
        position: fixed;
        z-index: 2000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
    }

    .modal-content-custom {
        background-color: #fff;
        margin: 5% auto;
        padding: 35px;
        border-radius: 25px;
        width: 90%;
        max-width: 550px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.15);
        border: none;
        position: relative;
    }

    .close-modal-custom {
        position: absolute;
        top: 20px;
        right: 25px;
        font-size: 1.5rem;
        cursor: pointer;
        color: #999;
        transition: color 0.2s;
    }

    .close-modal-custom:hover { color: var(--text-dark); }

    /* Edit Button Refinement */
    .edit-btn {
        border: 1px solid #eee;
        color: var(--primary-color) !important;
        background: transparent;
        transition: all 0.2s ease;
    }

    .edit-btn:hover {
        border-color: var(--primary-color) !important;
        background-color: var(--primary-color) !important;
        color: white !important;
        box-shadow: 0 4px 10px rgba(137, 93, 57, 0.15);
    }
    @media (max-width: 991px) {
        .checkout-premium-container { padding: 30px 20px; }
        .summary-sidebar { position: static; margin-top: 30px; }
        .checkout-title { font-size: 1.75rem; }
    }

    @media (max-width: 576px) {
        .section-card { padding: 20px 15px; }
        .address-card-custom { padding: 15px; }
        .checkout-item { flex-direction: column; text-align: center; }
        .product-img-checkout { width: 100px; height: 100px; }
        #addNewAddressBtn { 
            font-size: 0.50rem !important; 
            padding: 5px 12px !important;
        }
    }

    /* Custom validation styles */
    .form-control.is-invalid {
        border-color: #dc3545 !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }
    .invalid-feedback {
        font-size: 0.7rem;
        font-weight: 600;
        margin-top: 4px;
        color: #dc3545;
        display: none;
    }
    .form-control.is-invalid + .invalid-feedback {
        display: block;
    }

    /* Primary Theme Utility Classes */
    .text-primary-custom { color: var(--primary-color) !important; }
    .bg-primary-custom { background-color: var(--primary-color) !important; }
    
    .btn-primary-custom {
        background-color: var(--primary-color) !important;
        border-color: var(--primary-color) !important;
        color: white !important;
        transition: all 0.3s ease;
    }

    .btn-primary-custom:hover {
        background-color: #724a2d !important;
        border-color: #724a2d !important;
        color: white !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(137, 93, 57, 0.2);
    }

    .btn-outline-primary-custom {
        color: var(--primary-color) !important;
        border-color: var(--primary-color) !important;
        background: transparent !important;
        transition: all 0.3s ease;
    }

    .btn-outline-primary-custom:hover {
        background-color: var(--primary-color) !important;
        color: white !important;
    }

    .apply-coupon-btn {
        background-color: var(--primary-color) !important;
        color: white !important;
        border: none !important;
        font-size: 0.65rem !important;
        padding: 5px 12px !important;
        border-radius: 30px !important;
        font-weight: 700 !important;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.2s ease;
        box-shadow: 0 2px 4px rgba(137, 93, 57, 0.1);
    }

    .apply-coupon-btn:hover {
        background-color: #724a2d !important;
        color: white !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(137, 93, 57, 0.2);
    }
</style>

<div class="checkout-wrapper">
    <div class="container">
        <!-- Breadcrumbs -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb custom-breadcrumb">
                <li class="breadcrumb-item"><a href="/cart">Cart</a></li>
                <li class="breadcrumb-item active" aria-current="page">Checkout</li>
            </ol>
        </nav>

        <div class="checkout-premium-container">
            <h2 class="checkout-title">Complete Your Order</h2>

            <div class="row g-4">
                <!-- Left Column: Shipping & Items -->
                <div class="col-lg-8">
                    <!-- Shipping Address Section -->
                    <div class="section-card">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                            <h3 class="section-title mb-0"><i class="fas fa-truck-fast text-primary-custom"></i> Shipping Address</h3>
                            <button class="btn btn-outline-primary-custom btn-sm rounded-pill px-3" id="addNewAddressBtn" style="font-size: 0.75rem;">
                                <i class="fas fa-plus me-1"></i> New Address
                            </button>
                        </div>
                        
                        <div class="row g-3 billing-address">
                            <!-- Populated via JS -->
                            <div class="col-12 text-center py-4">
                                <div class="spinner-border text-primary-custom" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Order Items Section -->
                    <div class="section-card">
                        <h3 class="section-title"><i class="fas fa-box-open text-primary-custom"></i> Review Items</h3>
                        <div class="checkout-items-list">
                            <% cartItems.forEach(item => { %>
                                <% item.size.forEach(sizeItem => { %>
                                    <div class="checkout-item">
                                        <img src="/uploads/product-image/<%= item.productID.productImage[0] %>" 
                                             alt="<%= item.productID.productName %>" 
                                             class="product-img-checkout">
                                        <div class="flex-grow-1">
                                            <h6 class="fw-bold text-dark mb-1"><%= item.productID.productName %></h6>
                                            <div class="d-flex gap-3 small text-muted mb-2 justify-content-center justify-content-md-start">
                                                <span>Size: <strong><%= sizeItem.size %></strong></span>
                                                <span>Qty: <strong><%= sizeItem.quantity %></strong></span>
                                            </div>
                                            <p class="text-primary-custom fw-bold mb-0">
                                                <%= new Intl.NumberFormat('en-IN', { style: 'currency' , currency: 'INR', minimumFractionDigits: 0 }).format(sizeItem.quantity * item.price) %>
                                            </p>
                                        </div>
                                    </div>
                                <% }) %>
                            <% }) %>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Summary & Payment -->
                <div class="col-lg-4">
                    <div class="summary-sidebar">
                        <div class="summary-card">
                            <h4 class="fw-bold mb-4 border-bottom pb-3">Order Summary</h4>
                            
                            <!-- Payment Methods -->
                            <div class="payment-methods-section mb-4">
                                <p class="small fw-bold text-muted text-uppercase mb-3">Select Payment Method</p>
                                
                                <label class="payment-option-custom w-100">
                                    <input type="radio" name="payment" value="COD" id="codOption">
                                    <span class="payment-checkmark"></span>
                                    Cash On Delivery
                                </label>
                                <p id="codMessage" class="text-danger x-small mb-3" style="display: none; margin-top: -8px; margin-left: 10px;">
                                    <i class="fas fa-info-circle me-1"></i> COD only for orders below ₹5000
                                </p>

                                <label class="payment-option-custom w-100">
                                    <input type="radio" name="payment" value="Razorpay" checked>
                                    <span class="payment-checkmark"></span>
                                    Online Payment (Razorpay)
                                </label>

                                <label class="payment-option-custom w-100">
                                    <input type="radio" name="payment" value="Wallet">
                                    <span class="payment-checkmark"></span>
                                    Wallet <span class="small opacity-75 ms-1">(Bal: <%= new Intl.NumberFormat('en-IN', { style: 'currency' , currency: 'INR' }).format(walletBalance) %>)</span>
                                </label>
                            </div>

                            <!-- Coupon Section -->
                            <div class="coupon-box mb-4">
                                <p class="small fw-bold text-muted text-uppercase mb-2" style="font-size: 0.75rem;">Have a Coupon?</p>
                                <div class="input-group input-group-sm">
                                    <input type="text" id="couponCode" class="form-control rounded-start-pill border-end-0 px-3" placeholder="Code">
                                    <button class="btn btn-primary-custom rounded-end-pill px-3" id="applyCouponBtn" style="font-size: 0.75rem;">Apply</button>
                                    <button class="btn btn-outline-danger rounded-end-pill px-3 d-none" id="removeCouponBtn" style="font-size: 0.75rem;">Remove</button>
                                </div>
                                <p id="couponMessage" class="small mt-2 mb-0"></p>
                                
                                <% if (coupons && coupons.length > 0) { %>
                                    <div class="mt-3 border-top pt-2" style="max-height: 120px; overflow-y: auto;">
                                        <p class="x-small text-muted mb-2">Available Coupons:</p>
                                        <% coupons.forEach(coupon => { %>
                                            <div class="coupon-item-custom align-items-center" data-coupon="<%= coupon.name %>">
                                                <div>
                                                    <span class="fw-bold text-primary-custom small"><%= coupon.name %></span>
                                                    <div class="x-small text-muted opacity-75">Save ₹<%= coupon.offerPrice %></div>
                                                </div>
                                                <button class="btn btn-sm apply-coupon-btn">Apply</button>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Totals -->
                            <div class="summary-details">
                                <% 
                                    const baseSubtotal = subtotal / 1.18; 
                                    const gstSubtotal = subtotal - baseSubtotal; 
                                %>
                                <div class="summary-line">
                                    <span>Subtotal (Excl. GST)</span>
                                    <span id="subtotalBase" class="fw-bold text-dark"><%= new Intl.NumberFormat('en-IN', { style: 'currency' , currency: 'INR' }).format(baseSubtotal) %></span>
                                </div>
                                <div class="summary-line">
                                    <span>GST (18%)</span>
                                    <span id="subtotalGST" class="fw-bold text-dark"><%= new Intl.NumberFormat('en-IN', { style: 'currency' , currency: 'INR' }).format(gstSubtotal) %></span>
                                </div>
                                <div class="summary-line">
                                    <span>Delivery Charge</span>
                                    <span id="deliveryCharge" class="text-success fw-bold">FREE</span>
                                </div>
                                <div class="summary-line">
                                    <span>Discount</span>
                                    <span id="discount" class="text-danger fw-bold"><%= new Intl.NumberFormat('en-IN', { style: 'currency' , currency: 'INR' }).format(discount) %></span>
                                </div>
                                
                                <div class="summary-total">
                                    <span>To Pay</span>
                                    <span id="total"><%= new Intl.NumberFormat('en-IN', { style: 'currency' , currency: 'INR' }).format(total) %></span>
                                </div>
                            </div>

                            <button class="btn btn-primary-custom w-100 py-2 rounded-pill fw-bold mt-3 shadow-sm hvr-grow" id="placeOrderBtn" style="font-size: 0.9rem;">
                                Place Your Order <i class="fas fa-arrow-right ms-2 small"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
<div id="addAddressModal" class="checkout-modal">
    <div class="modal-content-custom">
        <span class="close-modal-custom">×</span>
        <h4 class="fw-bold mb-4">New Shipping Address</h4>
        <form id="addAddressForm">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">Label (Home, Office)</label>
                        <input type="text" name="label" id="addLabel" class="form-control rounded-3" placeholder="e.g. Home">
                        <div class="invalid-feedback">Please enter a label</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">Phone Number</label>
                        <input type="tel" name="phone" id="addPhone" class="form-control rounded-3" placeholder="9876543210">
                        <div class="invalid-feedback">Enter a valid 10-digit number</div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">Street Address</label>
                        <input type="text" name="street" class="form-control rounded-3" placeholder="House No, Building, Street">
                        <div class="invalid-feedback">Please enter your street address</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">City</label>
                        <input type="text" name="city" class="form-control rounded-3" placeholder="City">
                        <div class="invalid-feedback">Please enter your city</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">State</label>
                        <input type="text" name="state" class="form-control rounded-3" placeholder="State">
                        <div class="invalid-feedback">Please enter your state</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">Zip Code</label>
                        <input type="text" name="zipCode" class="form-control rounded-3" placeholder="600001">
                        <div class="invalid-feedback">Enter a valid 6-digit zip code</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">Country</label>
                        <input type="text" name="country" class="form-control rounded-3" value="India">
                        <div class="invalid-feedback">Please enter your country</div>
                    </div>
                </div>
                <div class="col-12 mt-4 text-center">
                    <button type="submit" class="btn btn-primary-custom w-100 py-2 rounded-pill fw-bold">Save & Select</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="editAddressModal" class="checkout-modal">
    <div class="modal-content-custom">
        <span class="close-modal-custom">×</span>
        <h4 class="fw-bold mb-4">Edit Address</h4>
        <form id="editAddressForm">
            <input type="hidden" name="addressId" id="editAddressId">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">Label</label>
                        <input type="text" name="label" id="editLabel" class="form-control rounded-3">
                        <div class="invalid-feedback">Please enter a label</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">Phone</label>
                        <input type="tel" name="phone" id="editPhone" class="form-control rounded-3">
                        <div class="invalid-feedback">Enter a valid 10-digit number</div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">Street</label>
                        <input type="text" name="street" id="editStreet" class="form-control rounded-3">
                        <div class="invalid-feedback">Please enter your street address</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">City</label>
                        <input type="text" name="city" id="editCity" class="form-control rounded-3">
                        <div class="invalid-feedback">Please enter your city</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">State</label>
                        <input type="text" name="state" id="editState" class="form-control rounded-3">
                        <div class="invalid-feedback">Please enter your state</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">Zip Code</label>
                        <input type="text" name="zipCode" id="editZipCode" class="form-control rounded-3">
                        <div class="invalid-feedback">Enter a valid 6-digit zip code</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-0">
                        <label class="small fw-bold">Country</label>
                        <input type="text" name="country" id="editCountry" class="form-control rounded-3">
                        <div class="invalid-feedback">Please enter your country</div>
                    </div>
                </div>
                <div class="col-12 mt-4 text-center">
                    <button type="submit" class="btn btn-primary-custom w-100 py-2 rounded-pill fw-bold">Update Address</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
    let addressesData = [];
    let selectedAddressIndex = 0;
    let appliedCoupon = null;

    document.addEventListener('DOMContentLoaded', () => {
        loadCheckoutAddresses();
        document.getElementById('addNewAddressBtn')?.addEventListener('click', showAddAddressModal);
        document.querySelectorAll('.close-modal-custom').forEach(btn => btn.addEventListener('click', closeModals));
        window.addEventListener('click', (e) => {
            if (e.target.classList.contains('checkout-modal')) closeModals();
        });
        document.getElementById('addAddressForm')?.addEventListener('submit', handleAddAddressSubmit);
        document.getElementById('editAddressForm')?.addEventListener('submit', handleEditAddressSubmit);
        document.getElementById('placeOrderBtn')?.addEventListener('click', placeOrder);
        document.getElementById('applyCouponBtn')?.addEventListener('click', () => applyCoupon());
        document.getElementById('removeCouponBtn')?.addEventListener('click', () => removeCoupon());
        setupCouponListeners();
        setupRealTimeValidation();
        updateCouponUI();
        updateCODAvailability();
    });

    function updateCODAvailability() {
        const totalElement = document.getElementById('total').textContent;
        const total = parseFloat(totalElement.replace(/[^0-9.]/g, '')) || 0;
        const codOption = document.getElementById('codOption');
        const codLabel = codOption?.parentElement;
        const codMessage = document.getElementById('codMessage');

        if (total >= 5000) {
            if (codOption) codOption.disabled = true;
            if (codLabel) codLabel.classList.add('disabled');
            if (codMessage) codMessage.style.display = 'block';
            if (codOption?.checked) {
                const razorpayOpt = document.querySelector('input[name="payment"][value="Razorpay"]');
                if (razorpayOpt) razorpayOpt.checked = true;
            }
        } else {
            if (codOption) codOption.disabled = false;
            if (codLabel) codLabel.classList.remove('disabled');
            if (codMessage) codMessage.style.display = 'none';
        }
    }

    function setupCouponListeners() {
        const applyButtons = document.querySelectorAll('.apply-coupon-btn');
        applyButtons.forEach(button => {
            button.addEventListener('click', (e) => {
                const couponCode = e.target.closest('.coupon-item-custom').getAttribute('data-coupon');
                applyCoupon(couponCode);
            });
        });
    }

    function updateCouponUI() {
        const applyButtons = document.querySelectorAll('.apply-coupon-btn');
        const couponInput = document.getElementById('couponCode');
        const applyCouponBtn = document.getElementById('applyCouponBtn');
        const removeCouponBtn = document.getElementById('removeCouponBtn');

        if (appliedCoupon) {
            applyButtons.forEach(btn => {
                const parent = btn.closest('.coupon-item-custom');
                if (parent && parent.getAttribute('data-coupon') === appliedCoupon) {
                    btn.textContent = 'Active';
                    btn.classList.add('bg-success');
                    btn.disabled = true;
                } else {
                    btn.disabled = true;
                    btn.style.opacity = '0.5';
                }
            });
            if (couponInput) {
                couponInput.disabled = true;
                couponInput.value = appliedCoupon;
            }
            if (applyCouponBtn) applyCouponBtn.classList.add('d-none');
            if (removeCouponBtn) removeCouponBtn.classList.remove('d-none');
        } else {
            applyButtons.forEach(btn => {
                btn.textContent = 'Apply';
                btn.classList.remove('bg-success');
                btn.disabled = false;
                btn.style.opacity = '1';
            });
            if (couponInput) {
                couponInput.disabled = false;
                couponInput.value = '';
            }
            if (applyCouponBtn) applyCouponBtn.classList.remove('d-none');
            if (removeCouponBtn) removeCouponBtn.classList.add('d-none');
            const messageElement = document.getElementById('couponMessage');
            if (messageElement) messageElement.textContent = '';
        }
        updateCODAvailability();
    }

    async function removeCoupon() {
        try {
            const response = await fetch('/remove-coupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            
            if (data.success) {
                appliedCoupon = null;
                document.getElementById('discount').textContent = formatCurrency(0);
                document.getElementById('total').textContent = formatCurrency(data.total);
                
                const deliveryElement = document.getElementById('deliveryCharge');
                if (deliveryElement) {
                   deliveryElement.textContent = data.deliveryCharge === 0 ? 'FREE' : formatCurrency(data.deliveryCharge);
                }
                
                updateCouponUI();
                Swal.fire({
                    icon: 'success',
                    title: 'Coupon Removed',
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    showCloseButton: true
                    
                });
            }
        } catch (error) {
            console.error('Error removing coupon:', error);
        }
    }

    async function applyCoupon(couponCodeFromList = null) {
        const couponCode = couponCodeFromList || document.getElementById('couponCode').value.trim();
        const messageElement = document.getElementById('couponMessage');
        const applyCouponBtn = document.getElementById('applyCouponBtn');

        if (!couponCode) {
            if (messageElement) {
                messageElement.textContent = 'Please enter a coupon code';
                messageElement.className = 'small mt-2 mb-0 text-danger';
            }
            return;
        }

        try {
            const response = await fetch('/apply-coupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ couponCode })
            });
            const data = await response.json();

            if (data.success) {
                appliedCoupon = data.couponCode;
                document.getElementById('discount').textContent = formatCurrency(data.discount);
                document.getElementById('total').textContent = formatCurrency(data.total);
                
                if (messageElement) messageElement.textContent = '';
                
                Swal.fire({
                    icon: 'success',
                    title: 'Coupon Applied!',
                    text: `Code ${data.couponCode} applied successfully`,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    showCloseButton: true
                });
                
                // Change UI of the applied coupon in list
                document.querySelectorAll('.coupon-item-custom').forEach(item => {
                    const btn = item.querySelector('.apply-coupon-btn');
                    if (item.getAttribute('data-coupon') === appliedCoupon) {
                        btn.textContent = 'Active';
                        btn.classList.add('text-success');
                    }
                });
                
                updateCouponUI();
            } else {
                if (messageElement) {
                    messageElement.textContent = data.message;
                    messageElement.className = 'small mt-2 mb-0 text-danger';
                }
            }
        } catch (error) {
            console.error('Error:', error);
        }
    }

    function formatCurrency(val) {
        return new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(val.toFixed(2));
    }

    async function loadCheckoutAddresses() {
        try {
            const response = await fetch('/api/checkout/addresses');
            const data = await response.json();
            if (data.success) {
                const addresses = data.addresses.address || [];
                addressesData = addresses.map((addr, index) => ({
                    id: addr._id,
                    index,
                    label: addr.label,
                    street: addr.street,
                    city: addr.city,
                    state: addr.state,
                    zipCode: String(addr.zipCode),
                    country: addr.country,
                    phone: addr.phone
                }));
                renderAddresses(addresses);
            }
        } catch (error) {
            console.error('Error loading addresses:', error);
        }
    }

    function renderAddresses(addresses) {
        const addressContainer = document.querySelector('.billing-address');
        if (!addressContainer) return;

        if (addresses.length === 0) {
            addressContainer.innerHTML = '<div class="col-12 py-3 text-muted">No addresses found. Add a new one to proceed.</div>';
            return;
        }

        addressContainer.innerHTML = '';
        addresses.forEach((address, index) => {
            const col = document.createElement('div');
            col.className = 'col-md-6';
            col.innerHTML = `
                <div class="address-card-custom ${index === parseInt(selectedAddressIndex) ? 'selected' : ''}" data-index="${index}" data-id="${address._id}">
                    <div class="address-label">${address.label}</div>
                    <div class="fw-bold text-dark mb-1 small">${address.street}</div>
                    <div class="text-muted x-small">${address.city}, ${address.state} ${address.zipCode}</div>
                    <div class="text-muted x-small mb-3">${address.country}</div>
                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                        <span class="x-small fw-bold"><i class="fa fa-phone me-1 opacity-50"></i> ${address.phone}</span>
                        <button class="btn btn-sm rounded-pill edit-btn" style="font-size: 0.7rem; padding: 2px 12px;">Edit</button>
                    </div>
                </div>
            `;
            
            const card = col.querySelector('.address-card-custom');
            card.addEventListener('click', function(e) {
                if (e.target.classList.contains('edit-btn')) return;
                document.querySelectorAll('.address-card-custom').forEach(c => c.classList.remove('selected'));
                this.classList.add('selected');
                selectedAddressIndex = this.getAttribute('data-index');
            });
            
            col.querySelector('.edit-btn').addEventListener('click', () => editAddress(index));
            addressContainer.appendChild(col);
        });
    }

    function showAddAddressModal() {
        const form = document.getElementById('addAddressForm');
        form.reset();
        
        // Clear previous validation states
        form.querySelectorAll('.form-control').forEach(el => {
            el.classList.remove('is-invalid');
        });
        
        // Auto-fill phone from user data if available
        const userPhone = '<%= user.phone %>';
        if (userPhone && userPhone !== '' && userPhone !== 'undefined' && userPhone !== 'null') {
            const phoneInput = document.getElementById('addPhone');
            if (phoneInput) {
                phoneInput.value = userPhone;
                // Optional: validate immediately if pre-filled
                validateField(phoneInput);
            }
        }
        
        document.getElementById('addAddressModal').style.display = 'block';
    }

    function editAddress(index) {
        const data = addressesData[index];
        if (!data) return;
        document.getElementById('editAddressId').value = data.id;
        document.getElementById('editLabel').value = data.label;
        document.getElementById('editStreet').value = data.street;
        document.getElementById('editCity').value = data.city;
        document.getElementById('editState').value = data.state;
        document.getElementById('editZipCode').value = data.zipCode;
        document.getElementById('editCountry').value = data.country;
        document.getElementById('editPhone').value = data.phone;
        document.getElementById('editAddressModal').style.display = 'block';
    }

    function closeModals() {
        document.getElementById('addAddressModal').style.display = 'none';
        document.getElementById('editAddressModal').style.display = 'none';
    }

    function validateField(field) {
        const value = field.value.trim();
        let isValid = true;
        let errorMessage = '';

        if (!value) {
            isValid = false;
            errorMessage = 'This field is required';
        } else {
            switch (field.name) {
                case 'zipCode': 
                    isValid = /^\d{6}$/.test(value);
                    errorMessage = 'Please enter a valid 6-digit zip code';
                    break;
                case 'phone':
                    isValid = /^[0-9]{10}$/.test(value.replace(/[^0-9]/g, ''));
                    errorMessage = 'Please enter a 10-digit phone number';
                    break;
                case 'label':
                    isValid = value.length >= 2;
                    errorMessage = 'Label must be at least 2 characters';
                    break;
                case 'street':
                    isValid = value.length >= 5;
                    errorMessage = 'Provide a more detailed address';
                    break;
            }
        }

        const feedback = field.parentElement.querySelector('.invalid-feedback');
        if (feedback) {
            feedback.textContent = errorMessage;
        }
        field.classList.toggle('is-invalid', !isValid);
        return isValid;
    }

    function setupRealTimeValidation() {
        document.querySelectorAll('#addAddressForm input, #editAddressForm input').forEach(input => {
            input.addEventListener('input', () => {
                if (input.classList.contains('is-invalid') || input.value.trim() !== '') {
                    validateField(input);
                }
            });
            input.addEventListener('blur', () => validateField(input));
        });
    }

    async function handleAddAddressSubmit(e) {
        e.preventDefault();
        const form = e.target;
        let isFormValid = true;
        form.querySelectorAll('input').forEach(input => {
            if (!validateField(input)) isFormValid = false;
        });
        if (!isFormValid) return;

        const body = Object.fromEntries(new FormData(form).entries());
        try {
            const res = await fetch('/api/checkout/addresses', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json();
            if (data.success) {
                await loadCheckoutAddresses();
                closeModals();
            } else {
                Swal.fire({ icon: 'error', title: 'Oops', text: data.message });
            }
        } catch (err) { console.error(err); }
    }

    async function handleEditAddressSubmit(e) {
        e.preventDefault();
        const form = e.target;
        const body = Object.fromEntries(new FormData(form).entries());
        const id = body.addressId;
        delete body.addressId;

        try {
            const res = await fetch(`/api/checkout/addresses/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            if ((await res.json()).success) {
                await loadCheckoutAddresses();
                closeModals();
            }
        } catch (err) { console.error(err); }
    }

    async function placeOrder() {
        const selectedAddress = document.querySelector('.address-card-custom.selected');
        if (!selectedAddress) {
            Swal.fire({ icon: 'warning', title: 'Address Required', text: 'Please select a shipping address', confirmButtonColor: '#895D39' });
            return;
        }

        const paymentMethod = document.querySelector('input[name="payment"]:checked').value;

        try {
            if (paymentMethod === 'Razorpay') {
                const response = await fetch('/create-razorpay-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ addressIndex: selectedAddressIndex, couponCode: appliedCoupon })
                });
                const data = await response.json();
                if (!data.success) throw new Error(data.message);

                const options = {
                    key: '<%= razorpayKeyId %>',
                    amount: data.order.amount,
                    currency: 'INR',
                    name: 'Jordan Express',
                    order_id: data.order.id,
                    handler: async (resp) => {
                        const verify = await fetch('/verify-razorpay-payment', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ ...resp, addressIndex: selectedAddressIndex, couponCode: appliedCoupon, orderId: data.orderId })
                        });
                        const verData = await verify.json();
                        if (verData.success) window.location.href = `/order-success/${verData.orderId}`;
                        else window.location.href = `/payment-failure?orderId=${data.orderId}`;
                    },
                    prefill: { name: '<%= user.name %>', email: '<%= user.email %>' },
                    theme: { color: '#895D39' },
                    modal: {
                        ondismiss: () => { window.location.href = `/payment-failure?orderId=${data.orderId}`; }
                    }
                };
                new Razorpay(options).open();
            } else {
                const response = await fetch('/place-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ addressIndex: selectedAddressIndex, paymentMethod, couponCode: appliedCoupon })
                });
                const data = await response.json();
                if (data.success) window.location.href = '/order-success/' + data.orderId;
                else Swal.fire({ icon: 'error', title: 'Order Failed', text: data.message });
            }
        } catch (error) {
            Swal.fire({ icon: 'error', title: 'Error', text: error.message });
        }
    }
</script>

<%- include('../partials/user/footer') %>