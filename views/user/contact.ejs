<%- include('../partials/user/header') %>

<style>
  :root {
    --primary: #895D39;
    --primary-dark: #5A3A22;
    --primary-light: #FDF8F4;
    --text-main: #2D3436;
    --text-muted: #636E72;
    --bg-alt: #F9F9F9;
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  body {
    font-family: 'Inter', sans-serif;
    color: var(--text-main);
    overflow-x: hidden;
  }

  .contact-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Hero Section */
  .contact-hero {
    margin-top: 0 !important;
    padding: 60px 0 40px;
    text-align: center;
    background: linear-gradient(to bottom, var(--primary-light), #fff);
  }

  .contact-hero h1 {
    font-size: 42px;
    font-weight: 900;
    margin-bottom: 15px;
    color: var(--text-main);
  }

  .contact-hero p {
    color: var(--text-muted);
    font-size: 16px;
    max-width: 500px;
    margin: 0 auto;
  }

  /* Main Layout */
  .contact-wrapper {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 60px;
    margin-bottom: 100px;
    margin-top: 40px;
  }

  /* Left Column: Info */
  .contact-info-card {
    background: var(--primary);
    color: white;
    padding: 50px;
    border-radius: 30px;
    height: fit-content;
    box-shadow: 0 20px 40px rgba(137, 93, 57, 0.2);
  }

  .contact-info-card h2 {
    font-size: 28px;
    font-weight: 800;
    margin-bottom: 40px;
  }

  .info-item {
    display: flex;
    gap: 20px;
    margin-bottom: 35px;
    align-items: flex-start;
  }

  .info-icon {
    width: 50px;
    height: 50px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }

  .info-text h4 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 5px 0;
  }

  .info-text p {
    font-size: 14px;
    opacity: 0.8;
    margin: 0;
    line-height: 1.5;
  }

  .social-links {
    display: flex;
    gap: 15px;
    margin-top: 50px;
  }

  .social-link {
    width: 45px;
    height: 45px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    text-decoration: none;
    transition: var(--transition);
  }

  .social-link:hover {
    background: white;
    color: var(--primary);
    transform: translateY(-5px);
  }

  /* Right Column: Form */
  .form-card {
    background: white;
    padding: 50px;
    border-radius: 30px;
    border: 1px solid #f1f1f1;
    box-shadow: 0 10px 30px rgba(0,0,0,0.02);
  }

  .form-card h2 {
    font-size: 28px;
    font-weight: 800;
    margin-bottom: 30px;
  }

  .contact-form-group {
    margin-bottom: 25px;
  }

  .contact-form-group label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 10px;
    letter-spacing: 1px;
  }

  .contact-input {
    width: 100%;
    padding: 15px 20px;
    border-radius: 15px;
    border: 1px solid #eee;
    background: #fafafa;
    font-family: inherit;
    font-size: 15px;
    transition: var(--transition);
    outline: none;
  }

  .contact-input:focus {
    border-color: var(--primary);
    background: white;
    box-shadow: 0 0 0 4px rgba(137, 93, 57, 0.05);
  }

  .contact-textarea {
    height: 150px;
    resize: none;
  }

  .btn-submit {
    width: 100%;
    padding: 18px;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 15px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .btn-submit:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(137, 93, 57, 0.15);
  }

  .btn-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  /* Responsive */
  @media (max-width: 991px) {
    .contact-wrapper {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 768px) {
    .contact-hero h1 { font-size: 32px; }
    .contact-info-card, .form-card { padding: 30px 20px; }
    .contact-hero { padding: 40px 0 20px; }
  }
</style>

<section class="contact-hero">
  <div class="contact-container">
    <h1>Get in Touch</h1>
    <p>Have questions about our premium collection? We'd love to hear from you. Send us a message and we'll respond within 24 hours.</p>
  </div>
</section>

<div class="contact-container">
  <div class="contact-wrapper">
    <!-- Left: Contact Info -->
    <div class="contact-info-card">
      <h2>Contact Information</h2>
      
      <div class="info-item">
        <div class="info-icon"><i class="fas fa-map-marker-alt"></i></div>
        <div class="info-text">
          <h4>Visit Our Outlet</h4>
          <p>Jordan Express HQ, Fashion District<br>Manhattan, NY 10001</p>
        </div>
      </div>

      <div class="info-item">
        <div class="info-icon"><i class="fas fa-phone-alt"></i></div>
        <div class="info-text">
          <h4>Call Support</h4>
          <p>+1 (555) 0123-4567<br>Mon - Fri, 9am - 6pm EST</p>
        </div>
      </div>

      <div class="info-item">
        <div class="info-icon"><i class="fas fa-envelope"></i></div>
        <div class="info-text">
          <h4>Email Us</h4>
          <p>support@jordanexpress.com<br>info@jordanexpress.com</p>
        </div>
      </div>

      <div class="social-links">
        <a href="#" class="social-link"><i class="fab fa-facebook-f"></i></a>
        <a href="#" class="social-link"><i class="fab fa-twitter"></i></a>
        <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
        <a href="#" class="social-link"><i class="fab fa-linkedin-in"></i></a>
      </div>
    </div>

    <!-- Right: Form -->
    <div class="form-card">
      <h2>Send a Message</h2>
      <form id="contactForm" novalidate>
        <div class="contact-form-group">
          <label>Full Name</label>
          <input type="text" id="fullName" class="contact-input" placeholder="e.g. John Doe">
        </div>

        <div class="contact-form-group">
          <label>Email Address</label>
          <input type="email" id="email" class="contact-input" placeholder="e.g. john@example.com">
        </div>

        <div class="contact-form-group">
          <label>How can we help?</label>
          <textarea id="message" class="contact-input contact-textarea" placeholder="Describe your inquiry..."></textarea>
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">
          <span>Send Message</span>
          <i class="fas fa-paper-plane"></i>
        </button>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contactForm');
    const submitBtn = document.getElementById('submitBtn');
    const fullName = document.getElementById('fullName');
    const email = document.getElementById('email');
    const message = document.getElementById('message');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Simple Validation
      if (!fullName.value.trim() || !email.value.trim()) {
        return Swal.fire({
          icon: 'warning',
          title: 'Missing Info',
          text: 'Please fill out your name and email.',
          confirmButtonColor: '#895D39'
        });
      }

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailPattern.test(email.value)) {
        return Swal.fire({
          icon: 'error',
          title: 'Invalid Email',
          text: 'Please enter a valid email address.',
          confirmButtonColor: '#895D39'
        });
      }

      submitBtn.disabled = true;
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = '<span>Sending...</span><i class="fas fa-spinner fa-spin"></i>';

      try {
        const response = await fetch('/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            fullName: fullName.value,
            email: email.value,
            message: message.value
          })
        });

        const result = await response.json();
        if (response.ok) {
          Swal.fire({
            icon: 'success',
            title: 'Message Sent!',
            text: 'We have received your message and will get back to you soon.',
            confirmButtonColor: '#895D39'
          });
          form.reset();
        } else {
          Swal.fire('Error', result.error || 'Submission failed.', 'error');
        }
      } catch (error) {
        Swal.fire('Error', 'An internal error occurred.', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  });
</script>

<%- include('../partials/user/footer') %>