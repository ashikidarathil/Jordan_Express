<%- include('../partials/user/dashboard-layout') %>

<style>
  .address-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
    margin-top: 30px;
  }

  .addr-card {
    background: white;
    border-radius: 16px;
    padding: 24px;
    border: 1px solid var(--dash-border);
    transition: var(--transition);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .addr-card:hover {
    box-shadow: var(--dash-shadow);
    transform: translateY(-3px);
  }

  .addr-type-icon {
    width: 40px;
    height: 40px;
    background: var(--primary-light);
    color: var(--dash-primary);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    margin-bottom: 20px;
  }

  .addr-label {
    font-weight: 800;
    font-size: 17px;
    color: var(--dash-text);
    margin-bottom: 8px;
    text-transform: capitalize;
  }

  .addr-details {
    font-size: 14px;
    color: var(--dash-text-muted);
    line-height: 1.6;
    flex: 1;
  }

  .addr-actions {
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid var(--dash-border);
    display: flex;
    gap: 12px;
  }

  .btn-addr-action {
    flex: 1;
    padding: 8px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: var(--transition);
    cursor: pointer;
  }

  .btn-edit { background: #f8f9fa; color: var(--dash-text); border: 1px solid #ddd; }
  .btn-delete { background: #fff5f5; color: #e53e3e; border: 1px solid #feb2b2; }

  .btn-edit:hover { background: #eee; }
  .btn-delete:hover { background: #fed7d7; }

  .default-label {
    position: absolute;
    top: 20px;
    right: 20px;
    background: #e6fffa;
    color: #2e7d32;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Aggressive Modal Overlay Fix */
  .modal-overlay {
    display: none;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: rgba(0, 0, 0, 0.4) !important; /* Slightly lighter for better contrast with alerts */
    backdrop-filter: blur(12px) !important;    /* Increased blur for premium feel */
    -webkit-backdrop-filter: blur(12px) !important;
    z-index: 99999 !important;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .modal-overlay.active {
    opacity: 1;
  }

  /* Fixed: Removed redundant layering overrides that were causing the layout gap */

  .modal-dash-content {
    background: white;
    border-radius: 28px;
    padding: 40px;
    width: 100%;
    max-width: 580px;
    box-shadow: 0 25px 80px -12px rgba(0, 0, 0, 0.35);
    z-index: 100000 !important;
    position: relative;
    transform: translateY(20px);
    transition: transform 0.3s ease;
  }

  .modal-overlay.active .modal-dash-content {
    transform: translateY(0);
  }

  .form-dash-input {
    width: 100%;
    padding: 12px 16px;
    border-radius: 12px;
    border: 1px solid var(--dash-border);
    background: #fafafa;
    outline: none;
    transition: var(--transition);
    font-size: 14px;
  }

  .form-dash-input:focus {
    border-color: var(--dash-primary);
    background: white;
    box-shadow: 0 0 0 4px rgba(139, 90, 43, 0.05);
  }

  @media (max-width: 768px) {
    .page-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
      margin-bottom: 25px;
    }

    .page-info h2 {
      font-size: 22px;
    }

    .page-info p {
      font-size: 13px;
      line-height: 1.5;
    }

    .btn-dash {
      width: 100%;
      justify-content: center;
      padding: 12px;
    }

    .address-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .addr-card {
      padding: 20px;
    }
  }
</style>

<div class="page-header">
  <div class="page-info">
    <h2>My Addresses</h2>
    <p>Manage your shipping and billing addresses for faster checkout.</p>
  </div>
  <button onclick="openAddressModal()" class="btn-dash btn-dash-primary">
    <i class="fas fa-plus"></i> Add New Address
  </button>
</div>

<% if (userAddress && userAddress.address && userAddress.address.length > 0) { %>
  <div class="address-grid">
    <% userAddress.address.forEach(address => { %>
      <div class="addr-card">
        <% if (address.isDefault) { %>
          <span class="default-label">Default</span>
        <% } %>
        
        <div class="addr-type-icon">
          <i class="fas <%= address.label.toLowerCase() === 'home' ? 'fa-home' : (address.label.toLowerCase() === 'work' ? 'fa-briefcase' : 'fa-map-marker-alt') %>"></i>
        </div>
        
        <div class="addr-label"><%= address.label %></div>
        
        <div class="addr-details">
          <strong><%= user.name %></strong><br>
          <%= address.street %><br>
          <%= address.city %>, <%= address.state %><br>
          <%= address.zipCode %>, <%= address.country %><br>
          <i class="fas fa-phone-alt me-1 mt-2" style="font-size: 12px;"></i> <%= address.phone %>
        </div>
        
        <div class="addr-actions">
          <button 
            onclick="openEditModal(this)" 
            data-address='<%= JSON.stringify(address).replace(/'/g, "&#39;") %>' 
            class="btn-addr-action btn-edit">
            <i class="fas fa-edit"></i> Edit
          </button>
          <button onclick="confirmDelete('<%= address._id %>')" class="btn-addr-action btn-delete">
            <i class="fas fa-trash-alt"></i> Delete
          </button>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="dash-card">
    <div class="empty-state">
      <i class="fas fa-map-marked-alt empty-icon"></i>
      <h3>No addresses saved</h3>
      <p>Please add a shipping address to speed up your checkout process.</p>
      <!-- <button onclick="openAddressModal()" class="btn-dash btn-dash-primary">
        <i class="fas fa-plus"></i> Add Your First Address
      </button> -->
    </div>
  </div>
<% } %>

<!-- Add New Address Modal -->
<div id="addressModal" class="modal-overlay">
  <div class="modal-dash-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 style="font-weight: 800; margin: 0; font-size: 20px;">Add New Address</h3>
      <button type="button" onclick="closeModal()" style="background: none; border: none; font-size: 20px; color: #999;"><i class="fas fa-times"></i></button>
    </div>
    
    <form id="addressForm" action="/add-address" method="POST">
      <div class="row">
        <div class="col-md-6 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">Label (Home / Work)</label>
          <input type="text" class="form-dash-input" name="label" placeholder="e.g. Home" required>
        </div>
        <div class="col-md-6 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">Phone Number</label>
          <input type="text" class="form-dash-input" name="phone" placeholder="e.g. 9876543210" required>
        </div>
        <div class="col-12 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">Street Address</label>
          <input type="text" class="form-dash-input" name="street" placeholder="House No, Building, Street Name" required>
        </div>
        <div class="col-md-6 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">City</label>
          <input type="text" class="form-dash-input" name="city" placeholder="City" required>
        </div>
        <div class="col-md-6 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">ZIP / PIN Code</label>
          <input type="text" class="form-dash-input" name="zipCode" placeholder="6-digit ZIP" required>
        </div>
        <div class="col-md-6 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">State</label>
          <input type="text" class="form-dash-input" name="state" placeholder="State" required>
        </div>
        <div class="col-md-6 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">Country</label>
          <input type="text" class="form-dash-input" name="country" value="India" readonly>
        </div>
      </div>
      
      <div class="mt-4 pt-3 border-top d-flex gap-3">
        <button type="button" onclick="closeModal()" class="btn-dash" style="background: #eee; color: #444; flex: 1; justify-content: center;">Cancel</button>
        <button type="submit" class="btn-dash btn-dash-primary" style="flex: 2; justify-content: center;">Save Address</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Address Modal -->
<div id="editAddressModal" class="modal-overlay">
  <div class="modal-dash-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 style="font-weight: 800; margin: 0; font-size: 20px;">Edit Address</h3>
      <button type="button" onclick="closeEditModal()" style="background: none; border: none; font-size: 20px; color: #999;"><i class="fas fa-times"></i></button>
    </div>
    
    <form id="editAddressForm" onsubmit="handleEditSubmit(event)">
      <input type="hidden" name="addressId" id="edit_addressId">
      <div class="row">
        <div class="col-md-6 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">Label (Home / Work)</label>
          <input type="text" class="form-dash-input" name="label" id="edit_label" placeholder="e.g. Home" required>
        </div>
        <div class="col-md-6 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">Phone Number</label>
          <input type="text" class="form-dash-input" name="phone" id="edit_phone" placeholder="e.g. 9876543210" required>
        </div>
        <div class="col-12 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">Street Address</label>
          <input type="text" class="form-dash-input" name="street" id="edit_street" placeholder="House No, Building, Street Name" required>
        </div>
        <div class="col-md-6 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">City</label>
          <input type="text" class="form-dash-input" name="city" id="edit_city" placeholder="City" required>
        </div>
        <div class="col-md-6 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">ZIP / PIN Code</label>
          <input type="text" class="form-dash-input" name="zipCode" id="edit_zipCode" placeholder="6-digit ZIP" required>
        </div>
        <div class="col-md-6 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">State</label>
          <input type="text" class="form-dash-input" name="state" id="edit_state" placeholder="State" required>
        </div>
        <div class="col-md-6 mb-3">
          <label style="font-size: 12px; font-weight: 700; color: var(--dash-text-muted); margin-bottom: 8px; display: block; text-transform: uppercase;">Country</label>
          <input type="text" class="form-dash-input" name="country" id="edit_country" value="India" readonly>
        </div>
      </div>
      
      <div class="mb-3">
        <label class="d-flex align-items-center gap-2 cursor-pointer" style="cursor: pointer;">
          <input type="checkbox" name="isDefault" id="edit_isDefault" style="width: 18px; height: 18px; accent-color: var(--dash-primary);">
          <span style="font-size: 14px; font-weight: 700; color: var(--dash-text);">Set as default address</span>
        </label>
      </div>

      <div class="mt-4 pt-3 border-top d-flex gap-3">
        <button type="button" onclick="closeEditModal()" class="btn-dash" style="background: #eee; color: #444; flex: 1; justify-content: center;">Cancel</button>
        <button type="submit" class="btn-dash btn-dash-primary" style="flex: 2; justify-content: center;">Update Address</button>
      </div>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // Robust Modal teleportation to bypass stacking context issues
  function teleportModals() {
    const modals = ['addressModal', 'editAddressModal'];
    modals.forEach(id => {
      const modal = document.getElementById(id);
      if (modal && modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }
    });
  }

  // Initial teleport on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', teleportModals);
  } else {
    teleportModals();
  }

  function openAddressModal() {
    teleportModals(); 
    const modal = document.getElementById('addressModal');
    modal.style.display = 'flex';
    setTimeout(() => modal.classList.add('active'), 10);
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    const modal = document.getElementById('addressModal');
    modal.classList.remove('active');
    setTimeout(() => {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }, 300);
  }

  function openEditModal(btn) {
    teleportModals();
    const address = JSON.parse(btn.getAttribute('data-address'));
    document.getElementById('edit_addressId').value = address._id;
    document.getElementById('edit_label').value = address.label;
    document.getElementById('edit_phone').value = address.phone;
    document.getElementById('edit_street').value = address.street;
    document.getElementById('edit_city').value = address.city;
    document.getElementById('edit_zipCode').value = address.zipCode;
    document.getElementById('edit_state').value = address.state;
    document.getElementById('edit_country').value = address.country;
    document.getElementById('edit_isDefault').checked = address.isDefault;
    
    const modal = document.getElementById('editAddressModal');
    modal.style.display = 'flex';
    setTimeout(() => modal.classList.add('active'), 10);
    document.body.style.overflow = 'hidden';
  }

  function closeEditModal() {
    const modal = document.getElementById('editAddressModal');
    modal.classList.remove('active');
    setTimeout(() => {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }, 300);
  }

  async function handleEditSubmit(e) {
    e.preventDefault();
    const form = e.target;
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalBtnText = submitBtn.innerHTML;

    // Loading state
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Updating...';

    const formData = new FormData(form);
    const dataObj = Object.fromEntries(formData.entries());
    dataObj.isDefault = document.getElementById('edit_isDefault').checked ? 'on' : 'off';
    
    const addressId = dataObj.addressId;

    try {
      const response = await fetch(`/edit-address?id=${addressId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(dataObj)
      });

      const result = await response.json();
      
      // Close modal before showing alert to prevent double dimming
      closeEditModal();

      if (result.success) {
        Swal.fire({
          icon: 'success',
          title: 'Success!',
          text: 'Address updated successfully',
          confirmButtonColor: '#8b5a2b'
        }).then(() => {
          window.location.reload();
        });
      } else {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnText;
        Swal.fire({ icon: 'error', title: 'Error', text: result.message });
      }
    } catch (error) {
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalBtnText;
      Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to update address. Please try again.' });
    }
  }

  function confirmDelete(id) {
    Swal.fire({
      title: 'Are you sure?',
      text: "This address will be permanently removed.",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#e53e3e',
      cancelButtonColor: '#718096',
      confirmButtonText: 'Yes, Delete'
    }).then((result) => {
      if (result.isConfirmed) {
        window.location.href = `/delete-address?id=${id}`;
      }
    });
  }

  // Close modal on outside click
  window.onclick = function(event) {
    let addModal = document.getElementById('addressModal');
    let editModal = document.getElementById('editAddressModal');
    if (event.target == addModal) {
      closeModal();
    }
    if (event.target == editModal) {
      closeEditModal();
    }
  }

  // Handle Success Alert
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('success') === 'true') {
    Swal.fire({
      icon: 'success',
      title: 'Address Saved',
      text: 'Your address has been added successfully.',
      confirmButtonColor: '#8b5a2b'
    });
    window.history.replaceState({}, document.title, window.location.pathname);
  }
</script>

<%- include('../partials/user/dashboard-footer') %>