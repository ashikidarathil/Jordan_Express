<%- include('../partials/user/header') %>

<style>
  :root {
    --primary-color: #8b5a2b;
    --primary-dark: #724922;
    --primary-light: #f9f5f0;
    --error-color: #d32f2f;
    --text-main: #2d3436;
    --text-secondary: #636e72;
    --bg-body: #fbfbfb;
    --card-bg: #ffffff;
    --shadow-md: 0 10px 25px rgba(0, 0, 0, 0.08);
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .failure-page-wrapper {
    background-color: var(--bg-body);
    color: var(--text-main);
    line-height: 1.6;
    padding: 60px 20px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .failure-container {
    max-width: 800px;
    width: 100%;
    background: var(--card-bg);
    border-radius: 20px;
    box-shadow: var(--shadow-md);
    overflow: hidden;
    animation: slideUp 0.8s ease-out;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .header-banner-failure {
    background: linear-gradient(135deg, #e53935, #b71c1c);
    padding: 40px 20px;
    text-align: center;
    color: white;
  }

  .icon-wrapper-failure {
    width: 80px;
    height: 80px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 20px;
    backdrop-filter: blur(5px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  @keyframes scaleIn {
    from { transform: scale(0.5); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .header-banner-failure h1 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 10px;
    color: white;
  }

  .header-banner-failure p {
    color: white;
    opacity: 0.9;
    margin-bottom: 0;
  }

  .content-wrapper {
    padding: 40px;
  }

  .alert-box {
    background: #fff5f5;
    border: 1px solid #fed7d7;
    color: #c53030;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 30px;
    text-align: center;
  }

  .order-summary {
    background: #fbfbfb;
    border: 1px solid #eee;
    border-radius: 15px;
    padding: 25px;
    margin-bottom: 30px;
  }

  .summary-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-main);
  }

  .summary-line {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    font-size: 15px;
    color: var(--text-secondary);
  }

  .total-line {
    margin-top: 15px;
    padding-top: 15px;
    border-top: 2px dashed #eee;
    font-size: 20px;
    font-weight: 700;
    color: var(--primary-color);
  }

  .btn-group-failure {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 30px;
  }

  .btn-failure-page {
    width: 100%;
    padding: 16px;
    border-radius: 12px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: var(--transition);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    border: none;
    font-size: 16px;
    font-family: 'Outfit', sans-serif;
  }

  .btn-primary-failure {
    background: var(--primary-color);
    color: white;
  }

  .btn-primary-failure:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
    color: white;
    box-shadow: 0 5px 15px rgba(139, 90, 43, 0.3);
  }

  .btn-outline-failure {
    background: white;
    border: 2px solid #eee;
    color: var(--text-main);
  }

  .btn-outline-failure:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
  }

  .support-text {
    margin-top: 30px;
    text-align: center;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .support-text a {
    color: var(--primary-color);
    text-decoration: none;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .content-wrapper {
      padding: 20px;
    }
    .header-banner-failure h1 {
      font-size: 26px;
    }
  }
</style>



<div class="failure-page-wrapper">
  <div class="failure-container">
    <div class="header-banner-failure">
      <div class="icon-wrapper-failure">
        <i class="fas fa-exclamation-triangle"></i>
      </div>
      <h1>Payment Failed</h1>
      <p>We couldn't process your transaction</p>
    </div>

    <div class="content-wrapper">
      <div class="alert-box">
        <p>Something went wrong with your payment method. Please check your bank details or try another option.</p>
      </div>

      <% if (typeof orderId !== 'undefined' && orderId) { %>
        <div class="order-summary">
          <h2 class="summary-title"><i class="fas fa-file-invoice"></i> Order Details</h2>
          <div class="summary-line">
            <span>Order Reference</span>
            <span style="font-weight: 600; color: var(--text-main);">#<%= orderId %></span>
          </div>
          <% if (typeof orderTotal !== 'undefined' && orderTotal !== null) { %>
            <% 
              const dCharge = typeof deliveryCharge !== 'undefined' ? Number(deliveryCharge) : 0;
              const dscount = typeof discount !== 'undefined' ? Number(discount) : 0;
              const total = Number(orderTotal);
              const subtotal = total + dscount - dCharge;
            %>
            <% if (typeof items !== 'undefined' && items) { %>
              <div class="summary-line">
                <span>Items Count</span>
                <span><%= items.length %> Items</span>
              </div>
            <% } %>
            <div class="summary-line">
              <span>Items Subtotal</span>
              <span><%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(subtotal) %></span>
            </div>
            <div class="summary-line">
              <span>Shipping Fee</span>
              <span class="<%= dCharge === 0 ? 'text-success fw-bold' : '' %>" <%= dCharge === 0 ? 'style="color: #2e7d32; font-weight: 600;"' : '' %>>
                <%= dCharge === 0 ? 'FREE' : new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(dCharge) %>
              </span>
            </div>
            <% if (dscount > 0) { %>
              <div class="summary-line" style="color: #d32f2f;">
                <span>Coupon Discount</span>
                <span>-<%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(dscount) %></span>
              </div>
            <% } %>
            
            <div class="summary-line total-line">
              <span>Payable Amount</span>
              <span><%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(total) %></span>
            </div>
          <% } %>
        </div>
      <% } %>

      <div class="btn-group-failure">
        <% if (typeof orderId !== 'undefined' && orderId) { %>
          <button class="btn-failure-page btn-primary-failure retry-payment-btn" data-order-id="<%= orderId %>">
            <i class="fas fa-redo"></i> Try Payment Again
          </button>
        <% } %>
        <a href="/order-details/<%= orderId %>" class="btn-failure-page btn-outline-failure">
          <i class="fas fa-file-invoice"></i> View Order Details
        </a>
        <a href="/shop" class="btn-failure-page btn-outline-failure" style="border: none;">
          Continue Shopping
        </a>
      </div>

      <div class="support-text">
        Having trouble? <a href="/contact">Contact support</a> or try again later.
      </div>
    </div>
  </div>
</div>

<!-- SDKs -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const retryPaymentBtn = document.querySelector('.retry-payment-btn');

    if (retryPaymentBtn) {
      retryPaymentBtn.addEventListener('click', async function () {
        const orderId = this.getAttribute('data-order-id');

        const result = await Swal.fire({
          title: 'Retry Payment?',
          text: 'We will reopen the payment secure portal for you.',
          icon: 'question',
          showCancelButton: true,
          confirmButtonColor: '#8b5a2b',
          cancelButtonColor: '#718096',
          confirmButtonText: 'Yes, Retry Now',
          cancelButtonText: 'Maybe Later',
          borderRadius: '15px'
        });

        if (!result.isConfirmed) return;

        try {
          const response = await fetch('/retry-razorpay-payment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId })
          });
          const data = await response.json();

          if (!data.success) {
            throw new Error(data.message || 'Failed to initiate payment');
          }

          let paymentCompleted = false;

          const options = {
            key: '<%= typeof razorpayKeyId !== "undefined" ? razorpayKeyId : "" %>',
            amount: data.order.amount,
            currency: 'INR',
            name: 'Jordan Express',
            description: 'Order Payment Retry',
            order_id: data.order.id,
            handler: async function (response) {
              paymentCompleted = true;
              const verifyResponse = await fetch('/verify-razorpay-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  razorpay_order_id: response.razorpay_order_id,
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_signature: response.razorpay_signature,
                  orderId: data.orderId
                }),
              });
              const verifyData = await verifyResponse.json();

              if (verifyData.success) {
                window.location.href = '/order-success/' + data.orderId;
              } else {
                window.location.href = `/payment-failure?orderId=${data.orderId}`;
              }
            },
            theme: { color: '#8b5a2b' },
            modal: {
              ondismiss: function () {
                if (!paymentCompleted) {
                  window.location.href = `/payment-failure?orderId=${orderId}`;
                }
              },
            },
          };

          const rzp = new Razorpay(options);
          rzp.on('payment.failed', function () {
            window.location.href = `/payment-failure?orderId=${orderId}`;
          });
          rzp.open();
          
        } catch (error) {
          Swal.fire({
            title: 'Error',
            text: error.message || 'An error occurred while initiating payment',
            icon: 'error',
            confirmButtonColor: '#8b5a2b'
          });
        }
      });
    }
  });
</script>

<%- include('../partials/user/footer') %>