<%- include('../partials/user/header') %>

<style>
    /* Custom Product Detail Styles */
    .product-detail-wrapper {
        padding: 20px 0 80px;
        background-color: #f8f9fa;
    }

    .product-detail-card {
        background: #fff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: 1px solid #f0f0f0;
    }
    
    .main-image-container {
        position: relative;
        background: #fff;
        border-radius: 15px;
        overflow: hidden;
        border: 1px solid #eee;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    #main-image {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }
    
    .thumbnail-list {
        display: flex;
        gap: 10px;
        margin-top: 15px;
        overflow-x: auto;
        padding-bottom: 5px;
    }
    
    .thumbnail-item {
        width: 80px;
        height: 80px;
        flex-shrink: 0;
        border-radius: 10px;
        border: 2px solid transparent;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .thumbnail-item.active {
        border-color: var(--primary-color);
    }
    
    .thumbnail-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .price-tag {
        font-size: 2rem;
        font-weight: 800;
        color: var(--primary-color);
    }
    
    .size-option {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        cursor: pointer;
        transition: all 0.2s;
        font-weight: 700;
    }
    
    .size-option:hover {
        border-color: var(--primary-color);
        color: var(--primary-color);
    }
    
    .size-option.selected {
        background-color: var(--primary-color);
        color: #fff;
        border-color: var(--primary-color);
    }
    
    .size-option.out-of-stock {
        opacity: 0.4;
        cursor: not-allowed;
        text-decoration: line-through;
    }
    
    .quantity-control {
        background: #f1f3f5;
        border-radius: 30px;
        padding: 5px;
        display: inline-flex;
        align-items: center;
        border: 1px solid #e9ecef;
    }
    
    .quantity-control .btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #fff;
        border: 1px solid #dee2e6;
        color: var(--primary-color);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .quantity-control input {
        width: 60px;
        text-align: center;
        border: none;
        background: transparent;
        font-weight: 700;
        font-size: 1.1rem;
    }
    
    .toggle-section {
        margin-top: 50px;
    }
    
    .toggle-nav {
        display: flex;
        gap: 30px;
        border-bottom: 2px solid #eee;
        margin-bottom: 30px;
    }
    
    .toggle-btn {
        padding-bottom: 15px;
        font-weight: 700;
        cursor: pointer;
        color: #adb5bd;
        position: relative;
        border: none;
        background: none;
    }
    
    .toggle-btn.active {
        color: var(--primary-color);
    }
    
    .toggle-btn.active::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 100%;
        height: 2px;
        background-color: var(--primary-color);
    }
    
    .toggle-content {
        display: none;
    }
    
    .toggle-content.active {
        display: block;
    }
    
    .wishlist-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dee2e6;
        cursor: pointer;
        transition: all 0.2s;
        color: #adb5bd;
    }
    
    .wishlist-icon.active {
        color: #ff4757;
        border-color: #ff4757;
        background-color: #fff5f5;
    }
    
    .img-magnifier-glass {
        position: absolute;
        border: 3px solid var(--primary-color);
        border-radius: 50%;
        cursor: none;
        width: 200px;
        height: 200px;
        display: none;
        background-repeat: no-repeat;
        z-index: 100;
        box-shadow: 0 0 15px rgba(0,0,0,0.2);
        pointer-events: none;
    }

    @media (max-width: 768px) {
        .product-card-custom { padding: 15px; }
        .img-magnifier-glass { display: none !important; }
    }
</style>

<div class="product-detail-wrapper">
    <div class="container mt-2">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb custom-breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
                <li class="breadcrumb-item active"><%= product.productName %></li>
            </ol>
        </nav>

        <div class="product-detail-card">
            <div class="row g-5">
                <!-- Gallery Section -->
                <div class="col-lg-6">
                    <div class="image-container main-image-container position-relative">
                        <% if (product.discountPercentage > 0) { %>
                            <span class="discount-badge"><%= product.discountPercentage %>% OFF</span>
                        <% } %>
                        <img src="/uploads/product-image/<%= product.productImage[0] %>" 
                             id="main-image" 
                             alt="<%= product.productName %>">
                        <div id="img-magnifier-glass" class="img-magnifier-glass"></div>
                    </div>
                    <div class="thumbnail-list">
                        <% product.productImage.forEach((img, index) => { %>
                            <div class="thumbnail-item <%= index === 0 ? 'active' : '' %> mb-2">
                                <img src="/uploads/product-image/<%= img %>" alt="thumb">
                            </div>
                        <% }) %>
                    </div>
                </div>

                <!-- Info Section -->
                <div class="col-lg-6">
                    <div class="ps-lg-4">
                        <h1 class="fw-bold mb-2"><%= product.productName %></h1>
                        <div class="d-flex align-items-center gap-2 mb-4">
                            <div class="text-warning small">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star-half-alt"></i>
                            </div>
                            <span class="text-muted small">(4.5/5 from 120 reviews)</span>
                        </div>

                        <div class="d-flex align-items-center gap-3 mb-4">
                            <span class="price-tag">
                                <%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: 0 }).format(product.salePrice) %>
                            </span>
                            <% if (product.discountPercentage > 0) { %>
                                <del class="text-muted fs-4" style="text-decoration: line-through !important;">
                                    <%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: 0 }).format(product.regularPrice) %>
                                </del>
                            <% } %>
                        </div>

                        <p class="text-muted mb-5"><%= product.description.substring(0, 200) %>...</p>

                        <div class="mb-5">
                            <h6 class="fw-bold mb-3">Select Size</h6>
                            <div class="d-flex flex-wrap gap-2 size-container">
                                <% product.size.forEach(sizeItem => { %>
                                    <div class="size-option <%= sizeItem.quantity <= 0 ? 'out-of-stock' : '' %>" 
                                         data-size="<%= sizeItem.size %>" 
                                         data-quantity="<%= sizeItem.quantity %>">
                                        <%= sizeItem.size %>
                                    </div>
                                <% }) %>
                            </div>
                            <p id="stockMessage" class="mt-2 small fw-bold text-danger" style="display: none;"></p>
                        </div>

                        <div class="d-flex flex-wrap align-items-center gap-4 mb-5">
                            <div class="quantity-control px-2">
                                <button class="btn btn-sm" id="decrement-btn"><i class="fas fa-minus"></i></button>
                                <input type="text" id="quantity-input" value="1" readonly>
                                <button class="btn btn-sm" id="increment-btn"><i class="fas fa-plus"></i></button>
                            </div>
                            <div class="wishlist-icon" title="Add to Wishlist">
                                <i class="far fa-heart fs-4"></i>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <button class="btn btn-primary-custom w-100 fw-bold button-add-to-cart h-100">
                                    <i class="fas fa-shopping-bag me-2"></i> Add to Cart
                                </button>
                            </div>
                            <div class="col-sm-6">
                                <button class="btn btn-primary-custom w-100 fw-bold button-buy-now h-100">
                                    Buy It Now
                                </button>
                            </div>
                        </div>

                        <div class="mt-5 border-top pt-4">
                            <div class="d-flex align-items-center gap-4 text-muted small">
                                <span><i class="fas fa-truck text-primary-custom me-2"></i> 2-Day Delivery</span>
                                <span><i class="fas fa-undo text-primary-custom me-2"></i> 30 Days Return</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabs Section -->
            <div class="toggle-section mt-5 border-top pt-5">
                <div class="toggle-nav">
                    <button class="toggle-btn active" data-target="description">Description</button>
                    <button class="toggle-btn" data-target="reviews">Reviews</button>
                    <button class="toggle-btn" data-target="similar">Similar Products</button>
                </div>

                <div class="toggle-content active" id="description">
                    <div class="row">
                        <div class="col-lg-8">
                            <h4 class="fw-bold mb-4">Product Overview</h4>
                            <div class="text-muted lh-lg">
                                <%= product.description %>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="toggle-content" id="reviews">
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="mb-5">
                                <h4 class="fw-bold mb-3">Customer Feedback</h4>
                                <div class="review-item mb-4 border-bottom pb-4">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="fw-bold">John Doe</span>
                                        <div class="text-warning small text-end"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                                    </div>
                                    <p class="text-muted small">Amazing quality and perfect fit. Will definitely buy again!</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="toggle-content" id="similar">
                    <div class="row g-4 mb-5">
                        <% if (similarProducts && similarProducts.length > 0) { %>
                            <% similarProducts.forEach(sp => { %>
                                <div class="col-6 col-md-4 col-lg-3">
                                    <div class="product-card-custom item position-relative h-100">
                                        <% if (sp.discountPercentage > 0) { %>
                                            <span class="discount-badge"><%= sp.discountPercentage %>% OFF</span>
                                        <% } %>
                                        
                                        <a href="/productDetails?id=<%= sp._id %>" class="d-block overflow-hidden">
                                            <img src="/uploads/product-image/<%= sp.productImage[0] %>" 
                                                 alt="<%= sp.productName %>" class="img-fluid w-100" style="aspect-ratio: 1; object-fit: cover;">
                                        </a>
                                        
                                        <div class="p-3 text-center">
                                            <a href="/productDetails?id=<%= sp._id %>" class="text-decoration-none text-dark fw-bold d-block mb-1 text-truncate">
                                                <%= sp.productName %>
                                            </a>
                                            <div class="text-warning small mb-2">
                                                <i class="fa-solid fa-star"></i>
                                                <i class="fa-solid fa-star"></i>
                                                <i class="fa-solid fa-star"></i>
                                                <i class="fa-solid fa-star"></i>
                                                <i class="fa-solid fa-star-half-stroke"></i>
                                            </div>
                                            <div class="price">
                                                <span class="fw-bold text-primary-custom fs-5">
                                                    <%= new Intl.NumberFormat('en-IN', { style: 'currency' , currency: 'INR' , minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(sp.salePrice) %>
                                                </span>
                                                <% if (sp.discountPercentage > 0) { %>
                                                    <del class="text-muted small ms-2" style="text-decoration: line-through !important;">
                                                        <%= new Intl.NumberFormat('en-IN', { style: 'currency' , currency: 'INR' , minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(sp.regularPrice) %>
                                                    </del>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-12 text-center py-5">
                                <p class="text-muted">No similar products found.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Modal functions
        const showModal = (message, type = 'info') => {
            Swal.fire({
                text: message,
                icon: type,
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                showCloseButton: true
            });
        };

        // Thumbnail image switching
        const thumbnails = document.querySelectorAll('.thumbnail-item');
        const mainImage = document.getElementById('main-image');
        
        thumbnails.forEach(thumb => {
            thumb.addEventListener('click', function() {
                thumbnails.forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                const newImg = this.querySelector('img').src;
                mainImage.src = newImg;
                initializeMagnifier(mainImage);
            });
        });

        // Size selection
        let selectedSize = null;
        let selectedSizeQuantity = 0;
        const sizeOptions = document.querySelectorAll('.size-option');
        const quantityInput = document.getElementById('quantity-input');
        const stockMessage = document.getElementById('stockMessage');
        const incrementBtn = document.getElementById('increment-btn');
        const decrementBtn = document.getElementById('decrement-btn');

        sizeOptions.forEach(option => {
            option.addEventListener('click', function() {
                if (this.classList.contains('out-of-stock')) {
                    showModal('This size is out of stock', 'error');
                    return;
                }
                sizeOptions.forEach(opt => opt.classList.remove('selected'));
                this.classList.add('selected');
                selectedSize = this.dataset.size;
                selectedSizeQuantity = parseInt(this.dataset.quantity);
                quantityInput.value = 1;
                stockMessage.textContent = `Only ${selectedSizeQuantity} left in stock!`;
                stockMessage.style.display = 'block';
                updateQuantityButtons();
            });
        });

        const updateQuantityButtons = () => {
            const current = parseInt(quantityInput.value);
            decrementBtn.disabled = current <= 1;
            incrementBtn.disabled = !selectedSize || current >= selectedSizeQuantity;
        };

        incrementBtn.addEventListener('click', () => {
            if (!selectedSize) return showModal('Please select a size first', 'warning');
            const current = parseInt(quantityInput.value);
            if (current < selectedSizeQuantity) {
                quantityInput.value = current + 1;
                updateQuantityButtons();
            }
        });

        decrementBtn.addEventListener('click', () => {
            const current = parseInt(quantityInput.value);
            if (current > 1) {
                quantityInput.value = current - 1;
                updateQuantityButtons();
            }
        });

        // Add to Cart / Buy Now
        const handleCartAction = async (isBuyNow = false) => {
            if (!selectedSize) return showModal('Please select a size', 'warning');
            const quantity = parseInt(quantityInput.value);

            try {
                const res = await fetch('/add-to-cart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        productId: '<%= product._id %>',
                        size: selectedSize,
                        quantity: quantity
                    })
                });
                const data = await res.json();
                if (data.success) {
                    if (isBuyNow) window.location.href = '/cart';
                    else {
                        showModal('Product added to cart!', 'success');
                        if (window.updateCartBadge) {
                            window.updateCartBadge(data.cartCount);
                        }
                    }
                } else {
                    showModal(data.message, 'error');
                }
            } catch (err) {
                console.error(err);
                showModal('Failed to add to cart', 'error');
            }
        };

        document.querySelector('.button-add-to-cart').addEventListener('click', () => handleCartAction(false));
        document.querySelector('.button-buy-now').addEventListener('click', () => handleCartAction(true));

        // Wishlist
        document.querySelector('.wishlist-icon').addEventListener('click', async function() {
            const isActive = this.classList.contains('active');
            const url = isActive ? '/remove-from-wishlist' : '/add-to-wishlist';
            
            try {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId: '<%= product._id %>' })
                });
                const data = await res.json();
                if (data.success) {
                    this.classList.toggle('active');
                    this.querySelector('i').className = this.classList.contains('active') ? 'fas fa-heart fs-4' : 'far fa-heart fs-4';
                    showModal(isActive ? 'Removed from wishlist' : 'Added to wishlist', 'success');
                }
            } catch (err) { console.error(err); }
        });

        // Tabs
        document.querySelectorAll('.toggle-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.toggle-content').forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                document.getElementById(this.dataset.target).classList.add('active');
            });
        });

        // Magnifier Logic
        const glass = document.getElementById('img-magnifier-glass');
        const img = document.getElementById('main-image');
        const zoom = 2.5;

        function initializeMagnifier(targetImg) {
            glass.style.backgroundImage = `url('${targetImg.src}')`;
            glass.style.backgroundSize = `${targetImg.width * zoom}px ${targetImg.height * zoom}px`;
        }

        const moveMagnifier = (e) => {
            const rect = img.getBoundingClientRect();
            let x = e.pageX - rect.left - window.pageXOffset;
            let y = e.pageY - rect.top - window.pageYOffset;
            
            const gw = glass.offsetWidth / 2;
            const gh = glass.offsetHeight / 2;

            if (x > img.width - (gw / zoom)) x = img.width - (gw / zoom);
            if (x < gw / zoom) x = gw / zoom;
            if (y > img.height - (gh / zoom)) y = img.height - (gh / zoom);
            if (y < gh / zoom) y = gh / zoom;

            glass.style.left = `${x - gw}px`;
            glass.style.top = `${y - gh}px`;
            glass.style.backgroundPosition = `-${(x * zoom) - gw}px -${(y * zoom) - gh}px`;
        };

        const imageContainer = document.querySelector('.image-container');
        imageContainer.addEventListener('mousemove', moveMagnifier);
        imageContainer.addEventListener('mouseenter', () => {
             if (window.innerWidth > 768) glass.style.display = 'block';
        });
        imageContainer.addEventListener('mouseleave', () => glass.style.display = 'none');
        
        mainImage.onload = () => initializeMagnifier(mainImage);
        if (mainImage.complete) initializeMagnifier(mainImage);

        // Check wishlist initial status
        const checkStatus = async () => {
            try {
                const res = await fetch('/wishlist');
                const html = await res.text();
                if (html.includes('<%= product._id %>')) {
                    const icon = document.querySelector('.wishlist-icon');
                    icon.classList.add('active');
                    icon.querySelector('i').className = 'fas fa-heart fs-4';
                }
            } catch (err) {}
        };
        checkStatus();
    });
</script>
<%- include('../partials/user/footer') %>