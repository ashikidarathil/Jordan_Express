<%- include('../partials/user/dashboard-layout') %>

<style>
  @media (max-width: 768px) {
    .page-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
      margin-bottom: 25px;
    }

    .page-info h2 {
      font-size: 22px;
    }

    .page-info p {
      font-size: 13px;
      line-height: 1.5;
    }

    .btn-dash {
      width: 100%;
      justify-content: center;
      padding: 12px;
    }

    .dash-card {
      padding: 20px;
    }

    .stat-icon {
      width: 50px !important;
      height: 50px !important;
      font-size: 20px !important;
    }

    .dash-card h3 {
      font-size: 20px !important;
    }
  }
</style>

<div class="page-header">
  <div class="page-info">
    <h2>Dashboard Overview</h2>
    <p>Welcome back, <strong><%= user.name %></strong>! Here's what's happening with your account.</p>
  </div>
  <a href="/edit-profile" class="btn-dash btn-dash-primary d-inline-flex">
    <i class="fas fa-edit"></i> Edit Profile
  </a>
</div>

<div class="row">
  <!-- Stats Cards -->
  <div class="col-md-4 mb-4">
    <div class="dash-card h-100 d-flex align-items-center gap-4">
      <div class="stat-icon" style="background: #fff5eb; color: #8b5a2b; width: 60px; height: 60px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px;">
        <i class="fas fa-shopping-bag"></i>
      </div>
      <div>
        <h3 style="font-size: 24px; font-weight: 800; margin: 0;"><%= orderCount %></h3>
        <p style="color: var(--dash-text-muted); margin: 0; font-size: 14px;">Total Orders</p>
      </div>
    </div>
  </div>

  <div class="col-md-4 mb-4">
    <div class="dash-card h-100 d-flex align-items-center gap-4">
      <div class="stat-icon" style="background: #e6fffa; color: #2e7d32; width: 60px; height: 60px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px;">
        <i class="fas fa-wallet"></i>
      </div>
      <div>
        <h3 style="font-size: 24px; font-weight: 800; margin: 0;">
          <%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(walletBalance) %>
        </h3>
        <p style="color: var(--dash-text-muted); margin: 0; font-size: 14px;">Wallet Balance</p>
      </div>
    </div>
  </div>

  <div class="col-md-4 mb-4">
    <div class="dash-card h-100 d-flex align-items-center gap-4">
      <div class="stat-icon" style="background: #ebf8ff; color: #3182ce; width: 60px; height: 60px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px;">
        <i class="fas fa-map-marker-alt"></i>
      </div>
      <div>
        <h3 style="font-size: 24px; font-weight: 800; margin: 0;"><%= addressCount %></h3>
        <p style="color: var(--dash-text-muted); margin: 0; font-size: 14px;">Saved Addresses</p>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-lg-8">
    <div class="dash-card">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 style="font-size: 18px; font-weight: 700; margin: 0;">Personal Information</h3>
        <i class="fas fa-shield-alt text-success" title="Verified Account"></i>
      </div>
      
      <div class="row">
        <div class="col-md-6 mb-3">
          <label style="display: block; font-size: 12px; font-weight: 600; color: var(--dash-text-muted); margin-bottom: 5px; text-transform: uppercase;">Full Name</label>
          <div style="padding: 12px; border: 1px solid var(--dash-border); border-radius: 10px; background: #fafafa; font-weight: 500;">
            <%= user.name %>
          </div>
        </div>
        <div class="col-md-6 mb-3">
          <label style="display: block; font-size: 12px; font-weight: 600; color: var(--dash-text-muted); margin-bottom: 5px; text-transform: uppercase;">Email Address</label>
          <div style="padding: 12px; border: 1px solid var(--dash-border); border-radius: 10px; background: #fafafa; font-weight: 500;">
            <%= user.email %>
          </div>
        </div>
        <div class="col-md-6 mb-3">
          <label style="display: block; font-size: 12px; font-weight: 600; color: var(--dash-text-muted); margin-bottom: 5px; text-transform: uppercase;">Phone Number</label>
          <div style="padding: 12px; border: 1px solid var(--dash-border); border-radius: 10px; background: #fafafa; font-weight: 500;">
            <%= user.phone || 'Not provided' %>
          </div>
        </div>
        <div class="col-md-6 mb-3">
          <label style="display: block; font-size: 12px; font-weight: 600; color: var(--dash-text-muted); margin-bottom: 5px; text-transform: uppercase;">Account Status</label>
          <div style="padding: 12px; border: 1px solid var(--dash-border); border-radius: 10px; background: #fafafa; font-weight: 500; color: #2e7d32;">
            <i class="fas fa-check-circle me-1"></i> Active
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="col-lg-4">
    <div class="dash-card" style="background: linear-gradient(135deg, var(--dash-primary), var(--dash-primary-dark)); color: white; border: none;">
      <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 15px;">Referral Program</h3>
      <p style="font-size: 14px; opacity: 0.9; margin-bottom: 20px;">Invite your friends to Jordan Express and earn rewards for every successful purchase they make!</p>
      <a href="/referral" class="btn-dash btn-dash-white w-100">
        <i class="fas fa-link"></i> Get My Invite Link
      </a>
    </div>
    
  </div>
</div>

<%- include('../partials/user/dashboard-footer') %>