<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - Jordan Express</title>
  
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    :root {
      --primary: #895D39;
      --primary-dark: #5A3A22;
      --primary-light: #FDF8F4;
      --text-main: #2D3436;
      --text-muted: #636E72;
      --bg-white: #FFFFFF;
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--primary-light);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      color: var(--text-main);
    }

    .auth-card {
      width: 100%;
      max-width: 420px;
      background: var(--bg-white);
      padding: 50px 40px;
      border-radius: 30px;
      box-shadow: 0 40px 100px rgba(137, 93, 57, 0.08);
      text-align: center;
    }

    .icon-box {
      width: 70px;
      height: 70px;
      background: #E3F2FD;
      color: #1976D2;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 30px;
      font-size: 28px;
    }

    .auth-card h1 {
      font-size: 26px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .auth-card p {
      color: var(--text-muted);
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 35px;
    }

    .form-group {
      margin-bottom: 30px;
      text-align: left;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 10px;
    }

    .input-wrapper {
      position: relative;
    }

    .input-wrapper > i:not(.eye-toggle) {
      position: absolute;
      left: 18px;
      top: 50%;
      transform: translateY(-50%);
      color: #999;
      font-size: 18px;
      transition: var(--transition);
      pointer-events: none;
    }

    .eye-toggle {
      position: absolute;
      right: 18px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: #999;
      font-size: 16px;
      z-index: 5;
    }

    .eye-toggle:hover { color: var(--primary); }

    .error-message {
      font-size: 11px;
      color: #dc3545;
      margin-top: 8px;
      display: none;
      font-weight: 600;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-5px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }

    .form-error .auth-input {
      border-color: #dc3545 !important;
      background-color: #fff9f9;
    }

    .auth-input {
      width: 100%;
      padding: 16px 50px 16px 50px;
      border: 1px solid #eee;
      background: #fafafa;
      border-radius: 15px;
      font-size: 15px;
      outline: none;
      transition: var(--transition);
    }

    .auth-input:focus {
      border-color: var(--primary);
      background: white;
      box-shadow: 0 0 0 4px rgba(137, 93, 57, 0.05);
    }

    .btn-auth-primary {
      width: 100%;
      padding: 18px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 15px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
    }

    .btn-auth-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
    }

    .alert {
      position: fixed;
      top: 40px;
      left: 50%;
      transform: translateX(-50%);
      background: #dc3545;
      color: white;
      padding: 12px 25px;
      border-radius: 12px;
      font-weight: 600;
      z-index: 1000;
    }
  </style>
</head>
<body>

  <% if (locals.message && locals.message.length> 0) { %>
    <div class="alert" id="alert"><%= locals.message %></div>
  <% } %>

  <div class="auth-card">
    <div class="icon-box">
      <i class="fas fa-sync-alt"></i>
    </div>
    <h1>Reset Password</h1>
    <p>Please enter your new password below. Ensure it's strong and unique to your account.</p>

    <form method="POST" action="/reset-password" id="reset-form" novalidate>
      <div class="form-group">
        <label>New Password</label>
        <div class="input-wrapper">
          <input type="password" name="password" id="password" class="auth-input" placeholder="Min 8 characters">
          <i class="fas fa-lock"></i>
          <i class="fas fa-eye eye-toggle" onclick="togglePass('password', this)"></i>
        </div>
        <div id="error-pass" class="error-message"></div>
      </div>

      <div class="form-group" style="margin-bottom: 35px;">
        <label>Confirm Password</label>
        <div class="input-wrapper">
          <input type="password" name="confirmPassword" id="confirmPassword" class="auth-input" placeholder="Repeat new password">
          <i class="fas fa-shield-alt"></i>
          <i class="fas fa-eye eye-toggle" onclick="togglePass('confirmPassword', this)"></i>
        </div>
        <div id="error-confirm" class="error-message"></div>
      </div>

      <button type="submit" class="btn-auth-primary">Update Password</button>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    function togglePass(id, icon) {
      const field = document.getElementById(id);
      field.type = field.type === 'password' ? 'text' : 'password';
      icon.classList.toggle('fa-eye');
      icon.classList.toggle('fa-eye-slash');
    }

    const passInput = document.getElementById('password');
    const confirmInput = document.getElementById('confirmPassword');
    const errorPass = document.getElementById('error-pass');
    const errorConfirm = document.getElementById('error-confirm');

    function validatePasswords() {
      let isValid = true;
      const pass = passInput.value;
      const confirmPass = confirmInput.value;
      const alpha = /[a-zA-Z]/;
      const digit = /\d/;

      // Reset styles
      passInput.parentElement.parentElement.classList.remove('form-error');
      confirmInput.parentElement.parentElement.classList.remove('form-error');
      errorPass.style.display = 'none';
      errorConfirm.style.display = 'none';

      if (!pass) {
        errorPass.innerText = 'New password is required';
        errorPass.style.display = 'block';
        passInput.parentElement.parentElement.classList.add('form-error');
        isValid = false;
      } else if (pass.length < 8 || !alpha.test(pass) || !digit.test(pass)) {
        errorPass.innerText = 'Must be 8+ characters with letters & numbers';
        errorPass.style.display = 'block';
        passInput.parentElement.parentElement.classList.add('form-error');
        isValid = false;
      }

      if (!confirmPass) {
        errorConfirm.innerText = 'Please confirm your password';
        errorConfirm.style.display = 'block';
        confirmInput.parentElement.parentElement.classList.add('form-error');
        isValid = false;
      } else if (pass !== confirmPass) {
        errorConfirm.innerText = 'Passwords do not match';
        errorConfirm.style.display = 'block';
        confirmInput.parentElement.parentElement.classList.add('form-error');
        isValid = false;
      }

      return isValid;
    }

    // Real-time validation
    passInput.addEventListener('input', validatePasswords);
    confirmInput.addEventListener('input', validatePasswords);

    document.getElementById('reset-form').addEventListener('submit', async function(e) {
      e.preventDefault();

      if (!validatePasswords()) {
        const card = document.querySelector('.auth-card');
        card.style.animation = 'none';
        card.offsetHeight; // trigger reflow
        card.style.animation = 'shake 0.4s ease';
        return;
      }

      try {
        const pass = passInput.value;
        const confirmPass = confirmInput.value;

        const response = await fetch('/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newPass1: pass, newPass2: confirmPass })
        });
        
        const data = await response.json();
        
        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Password Updated',
            text: data.message || 'Your password has been successfully reset.',
            showConfirmButton: false,
            timer: 1500
          }).then(() => {
            window.location.href = data.redirectUrl || '/login';
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Update Failed',
            text: data.message || 'There was an issue resetting your password.',
            confirmButtonColor: '#895D39'
          });
        }
      } catch (err) {
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'Something went wrong. Please try again later.',
          confirmButtonColor: '#895D39'
        });
      }
    });

    const alertBox = document.getElementById("alert");
    document.querySelectorAll("input").forEach(input => {
      input.addEventListener("input", () => {
        if (alertBox) alertBox.style.display = "none";
      });
    });
  </script>
</body>
</html>