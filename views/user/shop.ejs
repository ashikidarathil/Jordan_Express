<%- include('../partials/user/header') %>

<style>
    .shop-sidebar {
        background: #fff;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        height: fit-content;
    }
    .filter-group-title {
        font-weight: 800;
        color: var(--text-dark);
        margin-bottom: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .filter-group-title span { font-size: 1.1rem; }
    
    .price-range-btn {
        display: block;
        width: 100%;
        text-align: left;
        padding: 8px 15px;
        margin-bottom: 8px;
        border: 1px solid #eee;
        border-radius: 8px;
        background: #f8f9fa;
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.2s;
    }
    .price-range-btn:hover {
        background: var(--primary-color);
        color: #fff;
        border-color: var(--primary-color);
    }



    @media (min-width: 992px) {
        .shop-sidebar {
            position: sticky;
            top: 100px;
            z-index: 10;
        }
    }

    @media (max-width: 991px) {
        .offcanvas-body .shop-sidebar {
            background: transparent;
            box-shadow: none;
            padding: 20px 25px !important;
            border-radius: 0;
            margin-bottom: 0;
        }
    }
    
    .modal-container {
        display: none;
        position: fixed;
        top: 100px;
        right: 20px;
        z-index: 2000;
    }
    .modal-content-custom {
        padding: 15px 25px;
        border-radius: 10px;
        color: #fff;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
    .modal-success-bg { background-color: #28a745; }
    .modal-error-bg { background-color: #dc3545; }

    /* Luxury Price Range Slider Styles */
    .price-slider-container {
        padding: 5px 0 25px;
    }
    .slider-display {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px; /* Restored compact spacing after tooltip removal */
        background: rgba(139, 90, 43, 0.05); /* Very light primary */
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        padding: 12px 20px;
        border-radius: 12px;
        border: 1px solid rgba(139, 90, 43, 0.1);
        font-family: 'Outfit', sans-serif;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }
    .slider-display span {
        font-weight: 800;
        font-size: 1rem;
        color: var(--primary-color);
        letter-spacing: -0.5px;
    }
    .slider-track-wrapper {
        position: relative;
        width: 100%;
        height: 6px;
        background: #f1f1f1;
        border-radius: 10px;
        margin: 0 10px;
    }
    .slider-track {
        position: absolute;
        height: 100%;
        background: linear-gradient(90deg, var(--primary-color), #d4af37); /* Gold accent gradient */
        border-radius: 10px;
        box-shadow: 0 0 12px rgba(139, 90, 43, 0.3);
    }
    .slider-input-wrapper {
        position: relative;
        height: 20px;
        display: flex;
        align-items: center;
    }
    .slider-input-wrapper input[type="range"] {
        position: absolute;
        width: 100%;
        background: none;
        pointer-events: none;
        -webkit-appearance: none;
        appearance: none;
        z-index: 2;
    }
    input[type="range"]::-webkit-slider-thumb {
        height: 24px;
        width: 10px; /* Pill shape */
        border-radius: 5px;
        background: #fff;
        border: 2.5px solid var(--primary-color);
        pointer-events: auto;
        -webkit-appearance: none;
        cursor: grab;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15), 0 0 0 4px rgba(139, 90, 43, 0.05);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    input[type="range"]::-webkit-slider-thumb:active {
        cursor: grabbing;
        transform: scaleY(1.2);
        box-shadow: 0 6px 15px rgba(0,0,0,0.2), 0 0 0 6px rgba(139, 90, 43, 0.1);
    }
    input[type="range"]::-moz-range-thumb {
        height: 24px;
        width: 10px;
        border-radius: 5px;
        background: #fff;
        border: 2.5px solid var(--primary-color);
        pointer-events: auto;
        cursor: grab;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }
</style>

<div id="modal-container" class="modal-container">
    <div id="modal-content-box" class="modal-content-custom">
        <p id="modal-message" class="mb-0"></p>
    </div>
</div>

<div class="container py-5">
    <div class="row">
        <!-- Filters Trigger (Mobile) -->
        <div class="d-lg-none mb-4">
            <button class="btn btn-primary-custom w-100 py-3 d-flex align-items-center justify-content-center gap-2 shadow-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#shopSidebarOffcanvas" aria-controls="shopSidebarOffcanvas">
                <i class="fa-solid fa-filter"></i> FILTER PRODUCTS
            </button>
        </div>

        <!-- Sidebar Filters -->
        <aside class="col-lg-3">
            <div class="offcanvas-lg offcanvas-start" tabindex="-1" id="shopSidebarOffcanvas" aria-labelledby="shopSidebarOffcanvasLabel">
                <div class="offcanvas-header d-lg-none border-bottom px-4 py-3">
                    <h5 class="offcanvas-title fw-bold text-dark mb-0" id="shopSidebarOffcanvasLabel">FILTERS</h5>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" data-bs-target="#shopSidebarOffcanvas" aria-label="Close"></button>
                </div>
                
                <div class="offcanvas-body p-0">
                    <div class="shop-sidebar w-100">
                        <!-- Clear All Filters Button -->
                        <div class="mb-4 mt-4">
                            <button class="btn btn-primary-custom w-100 py-2 d-flex align-items-center justify-content-center gap-2" id="clearAll">
                                <i class="fa-solid fa-rotate-left small"></i> Clear All Filters
                            </button>
                        </div>

                        <!-- Categories -->
                        <div class="mb-4 pb-4 border-bottom">
                            <div class="filter-group-title">
                                <span>Categories</span>
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <% for(let i=0; i < category.length; i++) { %>
                                    <div class="form-check">
                                        <input class="form-check-input category-filter" type="checkbox" value="<%= category[i]._id %>" id="cat-<%= i %>" 
                                               <%= selectedCategories.includes(category[i]._id.toString()) ? 'checked' : '' %>>
                                        <label class="form-check-label small fw-semibold text-muted" for="cat-<%= i %>">
                                            <%= category[i].name %>
                                        </label>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Price Ranges Slider -->
                        <div class="mb-4 pb-4 border-bottom">
                            <div class="filter-group-title">
                                <span>Price Range</span>
                            </div>
                            <div class="price-slider-container">
                                <div class="slider-display mb-3">
                                    <span id="min-val">₹<%= minPrice %></span>
                                    <span class="text-muted fw-normal">to</span>
                                    <span id="max-val">₹<%= maxPrice > 50000 ? '50,000+' : maxPrice %></span>
                                </div>
                                <div class="slider-input-wrapper">
                                    <div class="slider-track-wrapper">
                                        <div class="slider-track" id="slider-track"></div>
                                    </div>
                                    <input type="range" id="min-price-slider" min="0" max="50000" value="<%= minPrice %>" step="500">
                                    <input type="range" id="max-price-slider" min="0" max="50000" value="<%= maxPrice > 50000 ? 50000 : maxPrice %>" step="500">
                                </div>
                                <div class="d-flex justify-content-between mt-2">
                                    <small class="text-muted">₹0</small>
                                    <small class="text-muted">₹50,000+</small>
                                </div>
                            </div>
                        </div>

                        <!-- Sort Options -->
                        <div>
                            <div class="filter-group-title">
                                <span>Sort By</span>
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <% const sortOptions = [
                                    { val: 'newest', label: 'Newest Arrivals' },
                                    { val: 'price-low', label: 'Price: Low to High' },
                                    { val: 'price-high', label: 'Price: High to Low' },
                                    { val: 'a-z', label: 'Name: A to Z' },
                                    { val: 'z-a', label: 'Name: Z to A' }
                                ]; %>
                                <% sortOptions.forEach((opt, idx) => { %>
                                    <div class="form-check">
                                        <input class="form-check-input sort-filter" type="radio" name="sort" value="<%= opt.val %>" id="sort-<%= idx %>" <%= sort === opt.val ? 'checked' : '' %>>
                                        <label class="form-check-label small fw-semibold text-muted" for="sort-<%= idx %>">
                                            <%= opt.label %>
                                        </label>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="col-lg-9">
            <!-- Search and Header Toolbar -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 p-3 bg-white rounded-4 shadow-sm">
                <h4 class="fw-bold mb-0 text-dark">Our Collection</h4>
                
                <form class="shop-search-form d-flex align-items-center" action="/search" method="post" style="max-width: 400px; width: 100%;">
                    <div class="input-group">
                        <input type="text" name="query" class="form-control border-end-0 rounded-start-pill px-4" placeholder="Search products..." style="height: 45px;" value="<%= search %>">
                        <% if (search && search.trim() !== '') { %>
                            <a href="/shop" class="btn btn-primary-custom border-start-0 rounded-end-pill px-3 d-flex align-items-center justify-content-center" style="height: 45px; width: 45px;">
                                <i class="fa-solid fa-xmark text-white"></i>
                            </a>
                        <% } else { %>
                            <button class="btn btn-primary-custom border-start-0 rounded-end-pill px-3" type="submit" style="height: 45px;">
                                <i class="fa-solid fa-search text-white"></i>
                            </button>
                        <% } %>
                    </div>
                </form>
            </div>

            <% if (products.length === 0) { %>
                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                    <div class="mb-4">
                        <i class="fa-solid fa-magnifying-glass fs-1 text-muted opacity-25"></i>
                    </div>
                    <h3 class="fw-bold text-dark">No products found</h3>
                    <p class="text-muted mb-4">Try adjusting your filters or search keywords.</p>
                    <a href="/shop" class="btn btn-primary-custom px-4 rounded-pill">View All Products</a>
                </div>
            <% } else { %>
                <div class="row g-4 mb-5">
                    <% for(let i=0; i < products.length; i++) { %>
                        <div class="col-6 col-md-4">
                            <div class="product-card-custom item position-relative h-100">
                                <% if (products[i].discountPercentage > 0) { %>
                                    <span class="discount-badge"><%= products[i].discountPercentage %>% OFF</span>
                                <% } %>
                                
                                <a href="/productDetails?id=<%= products[i]._id %>" class="d-block overflow-hidden">
                                    <img src="uploads/product-image/<%= products[i].productImage[0] %>" 
                                         alt="<%= products[i].productName %>" class="img-fluid w-100" style="aspect-ratio: 1; object-fit: cover;">
                                </a>
                                
                                <div class="p-3 text-center">
                                    <a href="/productDetails?id=<%= products[i]._id %>" class="text-decoration-none text-dark fw-bold d-block mb-1 text-truncate">
                                        <%= products[i].productName %>
                                    </a>
                                    <div class="text-warning small mb-2">
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star-half-stroke"></i>
                                    </div>
                                    <div class="price">
                                        <span class="fw-bold text-primary-custom fs-5">
                                            <%= new Intl.NumberFormat('en-IN', { style: 'currency' , currency: 'INR' , minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(products[i].salePrice) %>
                                        </span>
                                        <% if (products[i].discountPercentage > 0) { %>
                                            <del class="text-muted small ms-2" style="text-decoration: line-through !important;">
                                                <%= new Intl.NumberFormat('en-IN', { style: 'currency' , currency: 'INR' , minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(products[i].regularPrice) %>
                                            </del>
                                        <% } %>
                                    </div>
                                </div>
                                
                                <!-- Overlay Icons -->
                                <div class="icon-product">
                                    <a href="#" class="wishlist-icon shadow-sm" data-product-id="<%= products[i]._id %>" title="Add to Wishlist">
                                        <i class="fa-regular fa-heart"></i>
                                    </a>
                                    <a href="/productDetails?id=<%= products[i]._id %>" class="shadow-sm" title="View Details">
                                        <i class="fa-solid fa-cart-shopping"></i>
                                    </a>
                                    <a href="#" title="Compare">
                                        <i class="fa-solid fa-right-left"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- Pagination -->
                <% if (totalPages > 1) { %>
                    <nav aria-label="Product pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item <%= currentPages === 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="<%= currentPages > 1 ? `/shop?page=${currentPages - 1}&search=${search}&sort=${sort}&category=${selectedCategories.join(',')}&gt=${minPrice}&lt=${maxPrice}` : '#' %>">Previous</a>
                            </li>
                            
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <li class="page-item <%= currentPages === i ? 'active' : '' %>">
                                    <a class="page-link" href="/shop?page=<%= i %>&search=<%= search %>&sort=<%= sort %>&category=<%= selectedCategories.join(',') %>&gt=<%= minPrice %>&lt=<%= maxPrice %>"><%= i %></a>
                                </li>
                            <% } %>
                            
                            <li class="page-item <%= currentPages === totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="<%= currentPages < totalPages ? `/shop?page=${currentPages + 1}&search=${search}&sort=${sort}&category=${selectedCategories.join(',')}&gt=${minPrice}&lt=${maxPrice}` : '#' %>">Next</a>
                            </li>
                        </ul>
                    </nav>
                <% } %>
            <% } %>
        </main>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        function applyFilters() {
            const selectedCategories = Array.from(document.querySelectorAll('.category-filter:checked')).map(cb => cb.value);
            const selectedSort = document.querySelector('.sort-filter:checked')?.value;
            const searchQuery = document.querySelector('input[name="query"]')?.value || '';
            
            const gt = document.getElementById('min-price-slider').value;
            let lt = document.getElementById('max-price-slider').value;
            
            // If Max is at its top limit, let's treat it as "no limit" for the backend
            if (parseInt(lt) === 50000) lt = 1000000; 

            const params = new URLSearchParams();
            if (selectedCategories.length > 0) params.set('category', selectedCategories.join(','));
            params.set('gt', gt);
            params.set('lt', lt);
            if (selectedSort) params.set('sort', selectedSort);
            if (searchQuery) params.set('search', searchQuery);

            window.location.href = '/shop?' + params.toString();
        }

        // Slider Logic
        const minSlider = document.getElementById('min-price-slider');
        const maxSlider = document.getElementById('max-price-slider');
        const minValDisp = document.getElementById('min-val');
        const maxValDisp = document.getElementById('max-val');
        const track = document.getElementById('slider-track');
        const minGap = 2000; 

        function updateSliderTrack() {
            const minVal = parseInt(minSlider.value);
            const maxVal = parseInt(maxSlider.value);
            const percent1 = (minVal / minSlider.max) * 100;
            const percent2 = (maxVal / maxSlider.max) * 100;
            
            track.style.left = percent1 + "%";
            track.style.width = (percent2 - percent1) + "%";
            
            minValDisp.textContent = `₹${minVal.toLocaleString()}`;
            maxValDisp.textContent = maxVal >= 50000 ? '₹50,000+' : `₹${maxVal.toLocaleString()}`;
        }

        minSlider.addEventListener('input', () => {
            if (parseInt(maxSlider.value) - parseInt(minSlider.value) <= minGap) {
                minSlider.value = parseInt(maxSlider.value) - minGap;
            }
            minSlider.style.zIndex = "3";
            maxSlider.style.zIndex = "2";
            updateSliderTrack();
        });

        maxSlider.addEventListener('input', () => {
            if (parseInt(maxSlider.value) - parseInt(minSlider.value) <= minGap) {
                maxSlider.value = parseInt(minSlider.value) + minGap;
            }
            maxSlider.style.zIndex = "3";
            minSlider.style.zIndex = "2";
            updateSliderTrack();
        });

        // Trigger filter only on release (change) to avoid too many reloads
        minSlider.addEventListener('change', applyFilters);
        maxSlider.addEventListener('change', applyFilters);

        document.querySelectorAll('.category-filter, .sort-filter').forEach(el => {
            el.addEventListener('change', applyFilters);
        });

        updateSliderTrack(); // Initial track state

        document.getElementById('clearAll').addEventListener('click', () => {
            window.location.href = '/shop';
        });

        // Notification Modal
        function showModal(message, type = 'info') {
            const container = document.getElementById('modal-container');
            const contentBox = document.getElementById('modal-content-box');
            const msgP = document.getElementById('modal-message');
            
            contentBox.classList.remove('modal-success-bg', 'modal-error-bg');
            if (type === 'success') contentBox.classList.add('modal-success-bg');
            else if (type === 'error') contentBox.classList.add('modal-error-bg');
            
            msgP.textContent = message;
            container.style.display = 'block';
            setTimeout(() => { container.style.display = 'none'; }, 3000);
        }

        // Wishlist Logic
        document.querySelectorAll('.wishlist-icon').forEach(icon => {
            const productId = icon.dataset.productId;
            
            // Check initial state
            fetch('/wishlist').then(r => r.text()).then(html => {
                if (html.includes(`data-product-id="${productId}"`)) {
                    icon.classList.add('active');
                    icon.querySelector('i').classList.replace('fa-regular', 'fa-solid');
                }
            });

            icon.addEventListener('click', async function (e) {
                e.preventDefault();
                const isActive = this.classList.contains('active');
                try {
                    const res = await fetch(isActive ? '/remove-from-wishlist' : '/add-to-wishlist', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        this.classList.toggle('active');
                        this.querySelector('i').classList.toggle('fa-regular');
                        this.querySelector('i').classList.toggle('fa-solid');
                        showModal(isActive ? 'Removed from wishlist!' : 'Added to wishlist!', 'success');
                    }
                } catch (err) { showModal('Error updating wishlist', 'error'); }
            });
        });
    });
</script>

<%- include('../partials/user/footer') %>