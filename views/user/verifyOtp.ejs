<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Account - Jordan Express</title>
  
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    :root {
      --primary: #895D39;
      --primary-dark: #5A3A22;
      --primary-light: #FDF8F4;
      --text-main: #2D3436;
      --text-muted: #636E72;
      --bg-white: #FFFFFF;
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--primary-light);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      color: var(--text-main);
    }

    .auth-card {
      width: 100%;
      max-width: 420px;
      background: var(--bg-white);
      padding: 50px 40px;
      border-radius: 30px;
      box-shadow: 0 40px 100px rgba(137, 93, 57, 0.08);
      text-align: center;
    }

    .icon-box {
      width: 70px;
      height: 70px;
      background: #E8F5E9;
      color: #2E7D32;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 30px;
      font-size: 28px;
    }

    .auth-card h1 {
      font-size: 26px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .auth-card p {
      color: var(--text-muted);
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 30px;
    }

    .otp-container {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-bottom: 30px;
    }

    .otp-input {
      width: 48px;
      height: 56px;
      border: 1px solid #eee;
      background: #fafafa;
      border-radius: 12px;
      text-align: center;
      font-size: 20px;
      font-weight: 700;
      color: var(--text-main);
      transition: var(--transition);
      outline: none;
    }

    .otp-input:focus {
      border-color: var(--primary);
      background: white;
      box-shadow: 0 0 0 4px rgba(137, 93, 57, 0.05);
      transform: translateY(-2px);
    }

    .countdown-timer {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 25px;
    }

    .countdown-timer #timerValue {
      color: var(--primary);
      font-weight: 700;
    }

    .btn-auth-primary {
      width: 100%;
      padding: 18px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 15px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
      margin-bottom: 25px;
    }

    .btn-auth-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
    }

    .resend-btn {
      background: none;
      border: none;
      color: var(--primary);
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      transition: var(--transition);
      text-decoration: none;
    }

    .resend-btn:disabled { color: #ccc; cursor: not-allowed; }
    .resend-btn:not(:disabled):hover { text-decoration: underline; }

    .error-message {
      font-size: 11px;
      color: #dc3545;
      margin-top: -15px;
      margin-bottom: 20px;
      display: none;
      font-weight: 600;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-5px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }

    .form-error .otp-input {
      border-color: #dc3545 !important;
      background-color: #fff9f9;
    }

    .help-link {
        display: block;
        margin-top: 25px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
    }
    .help-link:hover { color: var(--primary); }

    .alert {
      position: fixed;
      top: 40px;
      left: 50%;
      transform: translateX(-50%);
      background: #dc3545;
      color: white;
      padding: 12px 25px;
      border-radius: 12px;
      font-weight: 600;
      z-index: 1000;
    }
  </style>
</head>
<body>

  <% if (locals.message && locals.message.length> 0) { %>
    <div class="alert" id="alert"><%= locals.message %></div>
  <% } %>

  <div class="auth-card">
    <div class="icon-box">
      <i class="fas fa-user-check"></i>
    </div>
    <h1>Verify Account</h1>
    <p>We've sent a verification code to your email. Please enter it below to activate your account.</p>

    <form id="verifyOtpForm">
      <div class="otp-container">
        <input type="text" class="otp-input" maxlength="1" oninput="this.value=this.value.replace(/[^0-9]/g,'')">
        <input type="text" class="otp-input" maxlength="1" oninput="this.value=this.value.replace(/[^0-9]/g,'')">
        <input type="text" class="otp-input" maxlength="1" oninput="this.value=this.value.replace(/[^0-9]/g,'')">
        <input type="text" class="otp-input" maxlength="1" oninput="this.value=this.value.replace(/[^0-9]/g,'')">
        <input type="text" class="otp-input" maxlength="1" oninput="this.value=this.value.replace(/[^0-9]/g,'')">
        <input type="text" class="otp-input" maxlength="1" oninput="this.value=this.value.replace(/[^0-9]/g,'')">
      </div>

      <div id="error-otp" class="error-message">Please enter all 6 digits.</div>

      <div class="countdown-timer" id="timerContainer">
        Resend code in <span id="timerValue">60</span>s
      </div>

      <button type="submit" class="btn-auth-primary">Verify Account</button>

      <button type="button" id="resendOtp" class="resend-btn" disabled onclick="handleResendOtp()">Resend Verification Code</button>
    </form>

    <a href="/signup" class="help-link">
      Need to use a different email? Go back to Signup
    </a>
  </div>

  <script src="registration/vendor/jquery/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    let timer = 60;
    let timerInterval;

    function startTimer() {
      timer = 60;
      const timerBtn = document.getElementById('resendOtp');
      const timerVal = document.getElementById('timerValue');
      timerBtn.disabled = true;
      timerVal.textContent = timer;
      
      clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        timer--;
        timerVal.textContent = timer;
        if (timer <= 0) {
          clearInterval(timerInterval);
          timerBtn.disabled = false;
          document.getElementById('timerContainer').style.visibility = 'hidden';
        }
      }, 1000);
    }

    startTimer();

    // OTP auto-focus logic
    const inputs = document.querySelectorAll('.otp-input');
    inputs.forEach((input, index) => {
      input.addEventListener('input', (e) => {
        if (e.target.value.length === 1 && index < inputs.length - 1) {
          inputs[index + 1].focus();
        }
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && e.target.value.length === 0 && index > 0) {
          inputs[index - 1].focus();
        }
      });
    });

    const errorOtp = document.getElementById('error-otp');

    document.getElementById('verifyOtpForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      let otpValue = "";
      inputs.forEach(i => otpValue += i.value);

      document.querySelector('.otp-container').classList.remove('form-error');
      errorOtp.style.display = 'none';

      if (otpValue.length < 6) {
        errorOtp.style.display = 'block';
        document.querySelector('.otp-container').classList.add('form-error');
        
        const card = document.querySelector('.auth-card');
        card.style.animation = 'none';
        card.offsetHeight; // trigger reflow
        card.style.animation = 'shake 0.4s ease';
        return;
      }

      try {
        const response = await $.ajax({
          type: 'POST',
          url: '/verify-otp',
          contentType: 'application/json',
          data: JSON.stringify({ otp: otpValue })
        });

        if (response.success) {
          Swal.fire({
            icon: 'success',
            title: 'Verified!',
            text: 'Your account is now active. Redirecting...',
            showConfirmButton: false,
            timer: 1500
          }).then(() => {
            window.location.href = response.redirectURL || response.redirectUrl;
          });
        } else {
          Swal.fire({ icon: 'error', title: 'Verification Failed', text: response.message, confirmButtonColor: '#895D39' });
        }
      } catch (err) {
        const msg = err.responseJSON && err.responseJSON.message ? err.responseJSON.message : 'Something went wrong. Please try again.';
        Swal.fire({ icon: 'error', title: 'Error', text: msg, confirmButtonColor: '#895D39' });
      }
    });

    async function handleResendOtp() {
      document.getElementById('resendOtp').disabled = true;

      // Show loading indicator
      Swal.fire({
        title: 'Sending OTP...',
        text: 'Please wait while we send a new code to your email.',
        allowOutsideClick: false,
        background: '#fff',
        color: '#2d2d2d',
        didOpen: () => {
          Swal.showLoading();
        }
      });

      try {
        const res = await fetch('/resend-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const response = await res.json();
        
        if (response.success) {
          Swal.fire({
            icon: 'success',
            title: 'OTP Resent!',
            text: 'A new verification code has been sent to your email address.',
            confirmButtonText: 'Got it',
            confirmButtonColor: '#895D39',
            background: '#fff',
            customClass: {
              popup: 'rounded-4'
            }
          }).then(() => {
            document.getElementById('timerContainer').style.visibility = 'visible';
            startTimer();
            inputs.forEach(i => i.value = '');
            inputs[0].focus();
          });
        } else {
          Swal.fire({ icon: 'error', title: 'Error', text: response.message || 'Failed to resend. Try again later.', confirmButtonColor: '#895D39' }).then(() => {
            document.getElementById('resendOtp').disabled = false;
          });
        }
      } catch (err) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Network or internal server error', confirmButtonColor: '#895D39' }).then(() => {
          document.getElementById('resendOtp').disabled = false;
        });
      }
    }
  </script>
</body>
</html>