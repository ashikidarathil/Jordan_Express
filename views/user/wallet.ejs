<%- include('../partials/user/dashboard-layout') %>

<style>
  .wallet-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(135deg, var(--dash-primary), var(--dash-primary-dark));
    color: white;
    border-radius: 20px;
    padding: 35px 40px;
    position: relative;
    overflow: hidden;
    margin-bottom: 30px;
    box-shadow: 0 10px 30px rgba(139, 90, 43, 0.15);
    gap: 30px;
  }

  .wallet-card::after {
    content: '';
    position: absolute;
    top: -50px;
    right: -50px;
    width: 200px;
    height: 200px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
  }

  /* Structural improvement: stay relative for content stacking */
  .wallet-card > * { position: relative; z-index: 2; }

  .balance-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
    margin-bottom: 5px;
    font-weight: 600;
  }

  .balance-amount {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 20px;
    letter-spacing: -0.5px;
    color: #ffffff;
  }

  .topup-box {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(8px);
    padding: 12px;
    border-radius: 14px;
    display: flex;
    gap: 12px;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    max-width: 500px;
  }

  .topup-input-container {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-grow: 1;
    padding-left: 10px;
  }

  .topup-input {
    background: transparent;
    border: none;
    color: white;
    font-size: 16px;
    font-weight: 600;
    width: 100%;
    outline: none;
  }

  .topup-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .btn-topup {
    background: var(--dash-primary);
    color: white;
    padding: 10px 20px;
    border-radius: 10px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    font-size: 14px;
    white-space: nowrap;
  }

  .btn-topup:hover {
    background: #9a6644;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .error-message {
    font-size: 13px;
    font-weight: 600;
    margin-top: 15px;
    display: none;
    color: #ffa8a8;
    align-items: center;
    gap: 8px;
  }

  .error-message i { font-size: 14px; }

  .transaction-item {
    background: white;
    border: 1px solid var(--dash-border);
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 12px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
    transition: var(--transition);
  }

  .trans-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }

  .icon-credit { background: #e8f5e9; color: #2e7d32; }
  .icon-debit { background: #ffebee; color: #c62828; }

  .trans-info h4 {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--dash-text);
    line-height: 1.4;
  }

  .trans-info p {
    margin: 1px 0 0;
    font-size: 11px;
    color: var(--dash-text-muted);
  }

  .trans-amount {
    font-weight: 700;
    font-size: 14px;
    white-space: nowrap;
  }

  .amount-credit { color: #2e7d32; }
  .amount-debit { color: #c62828; }

  /* Pagination Styling */
  .pagination-dash {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 30px;
  }

  .page-link-dash {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: white;
    border: 1px solid var(--dash-border);
    color: var(--dash-text);
    text-decoration: none;
    transition: var(--transition);
    font-weight: 700;
    font-size: 14px;
  }

  .pagination-dots {
    color: var(--dash-text-muted);
    font-weight: 800;
    letter-spacing: 1px;
    padding: 0 5px;
  }

  .page-link-dash:hover {
    border-color: var(--dash-primary);
    color: var(--dash-primary);
    background: var(--primary-light);
  }

  .page-link-dash.active {
    background: var(--dash-primary);
    color: white;
    border-color: var(--dash-primary);
    box-shadow: 0 4px 12px rgba(139, 90, 43, 0.2);
  }

  .page-link-dash.disabled {
    opacity: 0.5;
    pointer-events: none;
    background: #f8f9fa;
  }

  @media (max-width: 991px) {
    .wallet-card { flex-direction: column; align-items: flex-start; padding: 30px 20px; gap: 20px; }
    .topup-box { max-width: 100%; width: 100%; }
    .balance-amount { margin-bottom: 0; }
  }

  @media (max-width: 768px) {
    .wallet-card { padding: 30px 20px; text-align: left; }
    .balance-amount { font-size: 32px; }
    .topup-box { flex-direction: column; padding: 15px; }
    .topup-input-container { width: 100%; border-bottom: 1px solid rgba(255,255,255,0.1); padding: 0 0 10px 0; }
    .btn-topup { width: 100%; height: 45px; }
    .transaction-item { grid-template-columns: 1fr auto; gap: 10px; padding: 15px 12px; }
    .trans-icon { display: none; }
    .trans-info h4 { font-size: 12px; }
    .trans-info p { font-size: 10px; }
    .trans-amount { font-size: 12px; }
  }
</style>

<div class="page-header">
  <div class="page-info">
    <h2>My Wallet</h2>
    <p>Manage your digital balance and view transaction history.</p>
  </div>
</div>

<div class="wallet-card">
  <div class="balance-info">
    <div class="balance-label">Current Balance</div>
    <div class="balance-amount">
      <%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(wallet.balance) %>
    </div>
  </div>
  
  <div class="topup-container">
    <form id="addMoneyForm" class="topup-box">
      <div class="topup-input-container">
        <span style="font-size: 18px; opacity: 0.6;">₹</span>
        <input type="text" id="addMoneyAmount" class="topup-input" placeholder="Amount..." maxlength="12" inputmode="numeric">
      </div>
      <button type="submit" class="btn-topup">
        <i class="fas fa-plus me-1"></i> Add Money
      </button>
    </form>
    <div id="addMoneyError" class="error-message">
      <i class="fas fa-exclamation-circle"></i>
      <span class="error-text"></span>
    </div>
  </div>
</div>

<div class="dash-card">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 style="font-size: 18px; font-weight: 700; margin: 0;">Recent Transactions</h3>
  </div>

  <% if (wallet.transactions.length === 0) { %>
    <div class="empty-state pt-5 pb-5">
      <i class="fas fa-receipt empty-icon"></i>
      <h3>No transactions found</h3>
      <p>Your wallet activity will appear here once you make a purchase or top up your balance.</p>
    </div>
  <% } else { %>
    <div class="transaction-history">
      <% wallet.transactions.forEach(transaction => { %>
        <div class="transaction-item">
          <div class="trans-icon <%= transaction.type === 'credit' ? 'icon-credit' : 'icon-debit' %>">
            <i class="fas <%= transaction.type === 'credit' ? 'fa-arrow-down' : 'fa-arrow-up' %>"></i>
          </div>
          <div class="trans-info">
            <h4><%= transaction.description %></h4>
            <p>
              <%= transaction.date.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              <% if (transaction.orderID) { %> | Order #<%= transaction.orderID %><% } %>
            </p>
          </div>
          <div class="trans-amount <%= transaction.type === 'credit' ? 'amount-credit' : 'amount-debit' %>">
            <%= transaction.type === 'credit' ? '+' : '-' %> <%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(transaction.amount) %>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="pagination-dash">
        <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %>" class="page-link-dash <%= currentPage === 1 ? 'disabled' : '' %>">
          <i class="fas fa-chevron-left"></i>
        </a>
        
        <% 
          let startPage = Math.max(1, currentPage - 1);
          let endPage = Math.min(totalPages, currentPage + 1);
          
          if (currentPage <= 2) {
            endPage = Math.min(totalPages, 3);
          }
          if (currentPage >= totalPages - 1) {
            startPage = Math.max(1, totalPages - 2);
          }
        %>

        <% if (startPage > 1) { %>
          <a href="?page=1&limit=<%= limit %>" class="page-link-dash">1</a>
          <% if (startPage > 2) { %>
            <span class="pagination-dots">...</span>
          <% } %>
        <% } %>

        <% for(let i = startPage; i <= endPage; i++) { %>
          <a href="?page=<%= i %>&limit=<%= limit %>" class="page-link-dash <%= currentPage === i ? 'active' : '' %>">
            <%= i %>
          </a>
        <% } %>

        <% if (endPage < totalPages) { %>
          <% if (endPage < totalPages - 1) { %>
            <span class="pagination-dots">...</span>
          <% } %>
          <a href="?page=<%= totalPages %>&limit=<%= limit %>" class="page-link-dash"><%= totalPages %></a>
        <% } %>
        
        <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %>" class="page-link-dash <%= currentPage === totalPages ? 'disabled' : '' %>">
          <i class="fas fa-chevron-right"></i>
        </a>
      </div>
    <% } %>
  <% } %>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // Real-time Indian currency formatting
  const topupInput = document.getElementById('addMoneyAmount');
  topupInput.addEventListener('input', function() {
    // Strip everything except digits
    let raw = this.value.replace(/[^0-9]/g, '');
    if (raw) {
      // Format using Indian locale (e.g., 2,00,000)
      this.value = new Intl.NumberFormat('en-IN').format(parseInt(raw, 10));
    } else {
      this.value = '';
    }
  });

  document.getElementById('addMoneyForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    // Strip commas before parsing
    const amountStr = document.getElementById('addMoneyAmount').value.replace(/,/g, '');
    const amount = parseFloat(amountStr);
    const errorElement = document.getElementById('addMoneyError');

    if (!amount || amount <= 0) {
      errorElement.querySelector('.error-text').textContent = 'Please enter a valid amount';
      errorElement.style.display = 'flex';
      return;
    }
    if (amount < 100) {
      errorElement.querySelector('.error-text').textContent = 'Minimum top-up amount is ₹100';
      errorElement.style.display = 'flex';
      return;
    }

    try {
      errorElement.querySelector('.error-text').textContent = 'Initiating transaction...';
      errorElement.style.display = 'flex';
      errorElement.style.color = '#ffffff'; // Status color
      
      const response = await fetch('/create-wallet-topup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount })
      });
      const data = await response.json();

      if (!data.success) {
        errorElement.querySelector('.error-text').textContent = data.message || 'Failed to initiate payment';
        errorElement.style.display = 'flex';
        errorElement.style.color = '#ffa8a8';
        return;
      }

      errorElement.style.display = 'none';

      const options = {
        key: '<%= typeof razorpayKeyId !== "undefined" ? razorpayKeyId : "rzp_test_YourKeyHere" %>',
        amount: data.order.amount,
        currency: 'INR',
        name: 'Jordan Express',
        description: 'Wallet Top-Up',
        order_id: data.order.id,
        handler: async function (response) {
          const verifyResponse = await fetch('/verify-wallet-topup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              razorpay_order_id: response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature: response.razorpay_signature,
              amount
            })
          });
          const verifyData = await verifyResponse.json();

          if (verifyData.success) {
            Swal.fire({
              title: 'Success!',
              text: 'Money added to wallet successfully',
              icon: 'success',
              confirmButtonColor: '#8b5a2b'
            }).then(() => {
              window.location.reload();
            });
          } else {
            Swal.fire({
              title: 'Error',
              text: verifyData.message || 'Failed to add money',
              icon: 'error',
              confirmButtonColor: '#8b5a2b'
            });
          }
        },
        theme: { color: '#8b5a2b' },
        modal: {
          ondismiss: function () {
            Swal.fire({
              title: 'Payment Cancelled',
              text: 'Top-up was not completed',
              icon: 'warning',
              confirmButtonColor: '#8b5a2b'
            });
          }
        }
      };

      const rzp = new Razorpay(options);
      rzp.open();
    } catch (error) {
      console.error('Error initiating top-up:', error);
      errorElement.textContent = 'An error occurred. Please try again.';
    }
  });
</script>

<%- include('../partials/user/dashboard-footer') %>